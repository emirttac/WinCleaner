  <sys:String x:Key="tweak.hibernation.name">Disable Hibernation</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">用 powercfg 关闭休眠以及很大的 hiberfil.sys。好处：腾出磁盘。缺点：不能再休眠。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.wpbt.name">Disable WPBT Execution</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">阻止开机时执行 OEM 的 WPBT 负载。好处：减少厂商软件自行重装。注意：少数 OEM 工具可能依赖 WPBT。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.endtask.name">End Task From Taskbar</sys:String>
  <sys:String x:Key="tweak.endtask.desc">在 Win11 任务栏右键菜单加入结束任务。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Block Device Metadata From Network</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">阻止 Windows 从网络下载设备配套元数据。好处：后台流量更少。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Disable Store Search Suggestions</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">拒绝 Everyone 访问 Microsoft Store 本地搜索数据库。注意：商店更新可能重置权限。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Disable Explorer Folder Type Discovery</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">清除资源管理器 Bags/BagMRU，并强制 FolderType=NotSpecified。需要注销或重启。撤销只是再次清除。</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Unpin Explorer Home and Gallery</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">从 Win11 资源管理器导航窗格取消固定主页和库。不改变 LaunchTo。资源管理器会重启。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Disable Reserved Storage</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">通过 DISM 关闭 Windows 保留存储。好处：收回数 GB。注意：之后更新可能需要更多空闲空间。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Disable Storage Sense</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">关闭存储感知的自动清理。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">Prefer IPv4 Over IPv6</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">将 DisabledComponents 设为 32，优先 IPv4 但不完全关闭 IPv6。不要与 255 一起用。建议重启。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.teredo.name">Disable Teredo</sys:String>
  <sys:String x:Key="tweak.teredo.desc">用 netsh 关闭 Teredo IPv6 隧道接口。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.utctime.name">Hardware Clock Uses UTC</sys:String>
  <sys:String x:Key="tweak.utctime.desc">用 RealTimeIsUniversal 把 CMOS 时钟当作 UTC。适合与 Linux 双启动。注意：仅使用 Windows 时时间可能偏移。需要重启。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">Disable svchost Service Splitting</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">把 SvcHostSplitThresholdInKB 提到已装内存之上，让服务集中到更少的 svchost。危险：可能影响稳定性。需要重启。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Disable Notification Center and Toasts</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">关闭通知中心和横幅通知。注意：会错过系统和应用提醒。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Enable Win32 Long Paths</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">允许兼容应用使用超过 260 个字符的路径。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Verbose Logon Messages</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">在登录和注销时显示详细状态文字。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Verbose Blue Screen Details</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">显示蓝屏技术参数并关闭哭脸。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.numlock.name">Num Lock On at Startup</sys:String>
  <sys:String x:Key="tweak.numlock.desc">为登录屏幕和当前用户打开数字锁定。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Always Show Scrollbars</sys:String>
  <sys:String x:Key="tweak.scrollbars.desc">关闭自动隐藏的滚动条。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.stickykeys.name">Disable Sticky Keys Shortcut</sys:String>
  <sys:String x:Key="tweak.stickykeys.desc">关闭粘滞键，避免 Shift 弹出窗口打断游戏。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.settingshome.name">Hide Settings Home Page</sys:String>
  <sys:String x:Key="tweak.settingshome.desc">隐藏 Win11 设置的主页和建议页。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.lockscreen.name">Disable Lock Screen</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">跳过锁屏，直接进入密码或 PIN。注意：当面保护略弱。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Keep Network On in Connected Standby</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">在接通电源的新式待机 (S0) 期间允许联网。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Prefer Classic S3 Sleep</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">将 PlatformAoAcOverride 设为 0，以便在支持的硬件上使用传统 S3 睡眠。注意：并非所有笔记本都支持。需要重启。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Show Battery Percentage</sys:String>
  <sys:String x:Key="tweak.batterypercent.desc">在系统托盘显示数字电量。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.loginblur.name">Disable Logon Acrylic Blur</sys:String>
  <sys:String x:Key="tweak.loginblur.desc">关闭登录屏幕后面的亚克力模糊。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.windowsnap.name">Disable Window Snapping</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">关闭 Aero Snap 和窗口排列。若贴靠干扰游戏或多显示器布局时使用。可撤销：是。</sys:String>
  <sys:String x:Key="tweak.mpo.name">Disable Multiplane Overlay (MPO)</sys:String>
  <sys:String x:Key="tweak.mpo.desc">关闭 DWM 多平面叠加（OverlayTestMode=5）。用于黑屏、卡顿或全屏游戏问题。需要重启。可撤销：是。</sys:String>
