  <sys:String x:Key="app.crossdevice.name">Mobile Devices (Cross Device)</sys:String>
  <sys:String x:Key="app.crossdevice.desc">Cross-device experience package between your Microsoft devices. Safe to remove if you don’t use those features.</sys:String>
  <sys:String x:Key="app.soundrecorder.name">Sound Recorder</sys:String>
  <sys:String x:Key="app.soundrecorder.desc">Simple voice recorder. Safe to remove if you don’t need it.</sys:String>
  <sys:String x:Key="app.clock.name">Clock</sys:String>
  <sys:String x:Key="app.clock.desc">Clock, alarms, and timers app. Optional if you don’t use it.</sys:String>
  <sys:String x:Key="app.paint.name">Paint</sys:String>
  <sys:String x:Key="app.paint.desc">Classic Paint. Leave it unless you have a replacement — many people still open it for quick edits.</sys:String>
  <sys:String x:Key="app.notepad.name">Notepad</sys:String>
  <sys:String x:Key="app.notepad.desc">Notepad. Locked as a basic system text editor so you don’t remove it by mistake.</sys:String>
  <sys:String x:Key="app.snip.name">Snipping Tool</sys:String>
  <sys:String x:Key="app.snip.desc">Snipping Tool / screenshot app. Keep it unless you already use ShareX or similar.</sys:String>
  <sys:String x:Key="app.camera.name">Camera</sys:String>
  <sys:String x:Key="app.camera.desc">Camera app. Safe to remove on a desktop without a webcam.</sys:String>
  <sys:String x:Key="tweak.feathyperv.name">Enable Hyper-V</sys:String>
  <sys:String x:Key="tweak.feathyperv.desc">Turns the Hyper-V Windows feature on or off. Needed for some VMs and sandboxes; uses resources when enabled.</sys:String>
  <sys:String x:Key="tweak.featwsl.name">Enable WSL + Virtual Machine Platform</sys:String>
  <sys:String x:Key="tweak.featwsl.desc">Turns Windows Subsystem for Linux on or off.</sys:String>
  <sys:String x:Key="tweak.featsandbox.name">Enable Windows Sandbox</sys:String>
  <sys:String x:Key="tweak.featsandbox.desc">Turns Windows Sandbox on or off. Needs virtualization support.</sys:String>
  <sys:String x:Key="tweak.featdotnet.name">Enable .NET Framework 2/3/4 Features</sys:String>
  <sys:String x:Key="tweak.featdotnet.desc">Toggles older .NET Framework features some desktop apps still need.</sys:String>
  <sys:String x:Key="tweak.featmedia.name">Enable Legacy Media Components</sys:String>
  <sys:String x:Key="tweak.featmedia.desc">Toggles legacy Windows media features (older codecs / Media Features).</sys:String>
  <sys:String x:Key="tweak.featnfs.name">Enable NFS Client</sys:String>
  <sys:String x:Key="tweak.featnfs.desc">Toggles the NFS client feature for mounting NFS network shares.</sys:String>
  <sys:String x:Key="tweak.featf8.name">Enable Legacy F8 Boot Menu</sys:String>
  <sys:String x:Key="tweak.featf8.desc">Restores the legacy F8 advanced boot menu behavior where supported.</sys:String>
  <sys:String x:Key="tweak.wurecommended.name">Recommended Windows Update Deferrals</sys:String>
  <sys:String x:Key="tweak.wurecommended.desc">Limits or controls optional / recommended Windows Update offerings so fewer extras install themselves.</sys:String>
  <sys:String x:Key="tools.fixes">Fixes</sys:String>
  <sys:String x:Key="tools.legacy">Legacy Windows Panels</sys:String>
  <sys:String x:Key="tools.ntp">NTP — pool.ntp.org</sys:String>
  <sys:String x:Key="tools.ntp.desc">Syncs the clock with an NTP time server so Windows time stays accurate.</sys:String>
  <sys:String x:Key="tools.ntp.confirm">Configure Windows Time to use pool.ntp.org and force a resync?</sys:String>
  <sys:String x:Key="tools.autologon">Auto Logon (netplwiz)</sys:String>
  <sys:String x:Key="tools.autologon.desc">Signs in automatically with the selected account (stores credentials). Convenient on a home PC — weaker if others can touch the machine.</sys:String>
