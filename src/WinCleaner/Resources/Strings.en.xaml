  <sys:String x:Key="app.copilot.name">Copilot</sys:String>
  <sys:String x:Key="app.copilot.desc">Windows Copilot chat on the taskbar / Start. Remove carefully if you actually use it; you can reinstall from the Store.</sys:String>
  <sys:String x:Key="app.bingsearch.name">Bing Search</sys:String>
  <sys:String x:Key="app.bingsearch.desc">Bing extras that inject web results into Windows Search. Local search still works without it.</sys:String>
  <sys:String x:Key="app.outlook.name">Outlook (new)</sys:String>
  <sys:String x:Key="app.outlook.desc">The new Outlook for Windows app. Safe to remove if you use classic Outlook or another mail client — keep it if this is your daily mail.</sys:String>
  <sys:String x:Key="app.stickynotes.name">Sticky Notes</sys:String>
  <sys:String x:Key="app.stickynotes.desc">Sticky Notes. Safe to remove if you don’t use it; notes can come back via Store / Microsoft account.</sys:String>
  <sys:String x:Key="app.powerautomate.name">Power Automate</sys:String>
  <sys:String x:Key="app.powerautomate.desc">Desktop automation / flows app. Safe to remove if you never built a flow.</sys:String>
  <sys:String x:Key="app.devhome.name">Dev Home</sys:String>
  <sys:String x:Key="app.devhome.desc">Microsoft’s developer dashboard. Safe to remove if you’re not using it (Windows 11).</sys:String>
  <sys:String x:Key="app.xboxtcui.name">Xbox TCUI</sys:String>
  <sys:String x:Key="app.xboxtcui.desc">Xbox title-callable UI used by Game Bar / Game Pass popups. Leave it if you keep Game Bar or Game Pass.</sys:String>
  <sys:String x:Key="app.xboxspeech.name">Xbox speech overlay</sys:String>
  <sys:String x:Key="app.xboxspeech.desc">Xbox Game Bar speech-to-text overlay. Safe to remove if you don’t use in-game voice captions.</sys:String>
  <sys:String x:Key="app.family.name">Microsoft Family</sys:String>
  <sys:String x:Key="app.family.desc">Family Safety / parental controls companion. Safe to remove if you don’t manage child accounts on this PC.</sys:String>
  <sys:String x:Key="app.startexperiences.name">Start experiences</sys:String>
  <sys:String x:Key="app.startexperiences.desc">Start menu recommendations and suggested-app experiences on Windows 11. Start still works without it; suggestions just change.</sys:String>
  <sys:String x:Key="search.title">Search results</sys:String>
  <sys:String x:Key="search.subtitle">Matches across all categories</sys:String>
  <sys:String x:Key="search.resultsCount">{0} results</sys:String>
  <sys:String x:Key="search.noResults">No results for &quot;{0}&quot;</sys:String>
  <sys:String x:Key="search.openCategory">Open category</sys:String>
  <sys:String x:Key="tweak.hibernation.name">Disable Hibernation</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">Turns off hibernation and deletes the large hiberfil.sys file. Frees disk space; you lose hibernate / hybrid sleep.</sys:String>
  <sys:String x:Key="tweak.wpbt.name">Disable WPBT Execution</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">Blocks OEM WPBT payloads from running at boot so some vendor bloat can’t reinstall itself. Rare OEM tools may depend on it.</sys:String>
  <sys:String x:Key="tweak.endtask.name">End Task From Taskbar</sys:String>
  <sys:String x:Key="tweak.endtask.desc">Adds End task to the Windows 11 taskbar app right-click menu.</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Block Device Metadata From Network</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">Stops Windows from downloading device companion metadata from the internet — less background network chatter.</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Disable Store Search Suggestions</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">Blocks access to the Microsoft Store local search database (WinUtil-style). Fragile — Store updates may reset it and Store search can break.</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Disable Explorer Folder Type Discovery</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">Stops Explorer from auto-guessing folder templates (clears Bags/BagMRU). Needs sign-out or reboot; undo only partly clears bags again.</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Unpin Explorer Home and Gallery</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">Unpins Home and Gallery from the Explorer navigation pane on Windows 11. Use “Open Explorer to This PC” separately if you want that too. Explorer restarts.</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Disable Reserved Storage</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">Disables Windows Reserved Storage via DISM and can reclaim several GB. Updates may need more free space afterward.</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Disable Storage Sense</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">Turns off Storage Sense automatic cleanup.</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">Prefer IPv4 Over IPv6</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">Makes Windows prefer IPv4 without fully disabling IPv6. Don’t combine with Disable IPv6 — pick one. Reboot recommended.</sys:String>
  <sys:String x:Key="tweak.teredo.name">Disable Teredo</sys:String>
  <sys:String x:Key="tweak.teredo.desc">Disables the Teredo IPv6 tunneling interface via netsh.</sys:String>
  <sys:String x:Key="tweak.utctime.name">Hardware Clock Uses UTC</sys:String>
  <sys:String x:Key="tweak.utctime.desc">Treats the hardware clock as UTC (helpful for dual-boot with Linux). On Windows-only PCs the clock can skew until corrected. Reboot required.</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">Disable svchost Service Splitting</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">Groups services into fewer svchost processes. Dangerous — instability can take down more services at once. Reboot required.</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Disable Notification Center and Toasts</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">Disables Notification Center and toast notifications. You’ll miss system and app alerts.</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Enable Win32 Long Paths</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">Allows paths longer than 260 characters for compatible apps.</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Verbose Logon Messages</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">Shows detailed status text while signing in or out.</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Verbose Blue Screen Details</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">Shows technical BSOD details and disables the sad-face emoticon.</sys:String>
  <sys:String x:Key="tweak.numlock.name">Num Lock On at Startup</sys:String>
  <sys:String x:Key="tweak.numlock.desc">Turns Num Lock on for the logon screen and the current user.</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Always Show Scrollbars</sys:String>
  <sys:String x:Key="tweak.scrollbars.desc">Keeps scrollbars always visible instead of auto-hiding.</sys:String>
  <sys:String x:Key="tweak.stickykeys.name">Disable Sticky Keys Shortcut</sys:String>
  <sys:String x:Key="tweak.stickykeys.desc">Disables Sticky Keys so the Shift-key popup doesn’t interrupt games.</sys:String>
  <sys:String x:Key="tweak.settingshome.name">Hide Settings Home Page</sys:String>
  <sys:String x:Key="tweak.settingshome.desc">Hides the Windows 11 Settings home / recommendation page.</sys:String>
  <sys:String x:Key="tweak.lockscreen.name">Disable Lock Screen</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">Skips the lock screen and goes straight to the password/PIN prompt. Slightly weaker if someone has physical access to the PC.</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Keep Network On in Connected Standby</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">Allows network connectivity during Modern Standby (S0) while on AC power.</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Prefer Classic S3 Sleep</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">Prefers classic S3 sleep on supported hardware. Not all modern laptops support it; reboot required.</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Show Battery Percentage</sys:String>
  <sys:String x:Key="tweak.batterypercent.desc">Shows the numeric battery percentage in the system tray.</sys:String>
  <sys:String x:Key="tweak.loginblur.name">Disable Logon Acrylic Blur</sys:String>
  <sys:String x:Key="tweak.loginblur.desc">Disables the acrylic blur behind the sign-in screen.</sys:String>
  <sys:String x:Key="tweak.windowsnap.name">Disable Window Snapping</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">Turns off Aero Snap / window arrangement. Useful if snapping fights your games or multi-monitor layout.</sys:String>
  <sys:String x:Key="tweak.mpo.name">Disable Multiplane Overlay (MPO)</sys:String>
  <sys:String x:Key="tweak.mpo.desc">Disables DWM multiplane overlays. Try this for black screens, stutter, or overlay bugs with some GPUs/fullscreen games. Reboot required.</sys:String>
  <sys:String x:Key="blo.reinstall">Reinstall Selected</sys:String>
  <sys:String x:Key="blo.reinstallConfirm">Selected apps will be reinstalled via winget/Store IDs. Internet required. Continue?</sys:String>
  <sys:String x:Key="blo.reinstallNoStoreId">No Store/winget ID is available for: {0}</sys:String>
