  <sys:String x:Key="tweak.hibernation.name">Disable Hibernation</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">Turns off hibernation (and the large hiberfil.sys file) via powercfg. Benefit: Frees disk space. Downside: You lose hibernate / hybrid-sleep.</sys:String>
  <sys:String x:Key="tweak.wpbt.name">Disable WPBT Execution</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">Blocks OEM Windows Platform Binary Table payload execution at boot. Benefit: Stops some vendor bloat from reinstalling itself. Caution: Rare OEM tools may depend on WPBT.</sys:String>
  <sys:String x:Key="tweak.endtask.name">End Task From Taskbar</sys:String>
  <sys:String x:Key="tweak.endtask.desc">Adds End task to the Win11 taskbar app right-click menu.</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Block Device Metadata From Network</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">Stops Windows from downloading device companion metadata from the internet. Benefit: Less background network chatter.</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Disable Store Search Suggestions</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">Denies Everyone access to the Microsoft Store local search database (WinUtil-style). Caution: Fragile — Store updates may reset ACLs; may affect Store search.</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Disable Explorer Folder Type Discovery</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">Efface les Bags/BagMRU de l'Explorateur et force FolderType=NotSpecified pour empêcher la détection automatique des modèles de dossier. Déconnexion ou redémarrage requis.</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Unpin Explorer Home and Gallery</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">Unpins Home and Gallery from the Explorer navigation pane (Win11). Does not change LaunchTo — use Open Explorer to This PC separately. Explorer restarts.</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Disable Reserved Storage</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">Disables Windows Reserved Storage via DISM. Benefit: Reclaims several GB. Caution: Updates may need more free space afterward.</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Disable Storage Sense</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">Turns off Storage Sense automatic cleanup.</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">Prefer IPv4 Over IPv6</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">Sets Tcpip6 DisabledComponents=32 so Windows prefers IPv4 without fully disabling IPv6. Do not combine with Disable IPv6 (that sets 255) — pick one. Reboot recommended.</sys:String>
  <sys:String x:Key="tweak.teredo.name">Disable Teredo</sys:String>
  <sys:String x:Key="tweak.teredo.desc">Disables the Teredo IPv6 tunneling interface via netsh.</sys:String>
  <sys:String x:Key="tweak.utctime.name">Hardware Clock Uses UTC</sys:String>
  <sys:String x:Key="tweak.utctime.desc">Sets RealTimeIsUniversal so the CMOS clock is treated as UTC (helpful for dual-boot with Linux). Caution: On Windows-only PCs this can skew time until corrected. Reboot required.</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">Disable svchost Service Splitting</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">Raises SvcHostSplitThresholdInKB above installed RAM so Windows groups services into fewer svchost processes. Dangerous: Can hurt stability and make crashes take down more services. Reboot required.</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Disable Notification Center and Toasts</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">Disables Notification Center and toast notifications. Caution: You will miss system and app alerts.</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Enable Win32 Long Paths</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">Allows paths longer than 260 characters for compatible apps.</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Verbose Logon Messages</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">Shows detailed status text during sign-in/sign-out.</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Verbose Blue Screen Details</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">Shows technical BSOD parameters and disables the sad-face emoticon.</sys:String>
  <sys:String x:Key="tweak.numlock.name">Num Lock On at Startup</sys:String>
  <sys:String x:Key="tweak.numlock.desc">Enables Num Lock for the logon screen and current user.</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Always Show Scrollbars</sys:String>
  <sys:String x:Key="tweak.scrollbars.desc">Disables auto-hiding / dynamic scrollbars.</sys:String>
  <sys:String x:Key="tweak.stickykeys.name">Disable Sticky Keys Shortcut</sys:String>
  <sys:String x:Key="tweak.stickykeys.desc">Turns off Sticky Keys (stops the Shift-key popup that interrupts games).</sys:String>
  <sys:String x:Key="tweak.settingshome.name">Hide Settings Home Page</sys:String>
  <sys:String x:Key="tweak.settingshome.desc">Hides the Win11 Settings home/recommendation page.</sys:String>
  <sys:String x:Key="tweak.lockscreen.name">Disable Lock Screen</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">Skips the lock screen and goes straight to the password/PIN prompt. Caution: Slightly weaker physical-access UX.</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Keep Network On in Connected Standby</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">Allows network connectivity during Modern Standby (S0) on AC power.</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Prefer Classic S3 Sleep</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">Sets PlatformAoAcOverride=0 to prefer legacy S3 sleep on supported hardware. Caution: Not all modern laptops support this; reboot required.</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Show Battery Percentage</sys:String>
  <sys:String x:Key="tweak.batterypercent.desc">Shows the numeric battery percentage in the system tray.</sys:String>
  <sys:String x:Key="tweak.loginblur.name">Disable Logon Acrylic Blur</sys:String>
  <sys:String x:Key="tweak.loginblur.desc">Disables the acrylic blur behind the sign-in screen.</sys:String>
  <sys:String x:Key="tweak.windowsnap.name">Disable Window Snapping</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">Turns off Aero Snap / window arrangement. Useful if snapping interferes with games or multi-monitor layouts.</sys:String>
  <sys:String x:Key="tweak.mpo.name">Disable Multiplane Overlay (MPO)</sys:String>
  <sys:String x:Key="tweak.mpo.desc">Disables DWM multiplane overlays (OverlayTestMode=5 + DisableOverlays). When to use: Black screens, stutter, or overlay bugs with some GPUs/fullscreen games. Reboot required.</sys:String>
