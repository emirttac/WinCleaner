  <sys:String x:Key="app.copilot.name">Copilot</sys:String>
  <sys:String x:Key="app.copilot.desc">L’app de chat Copilot Windows dans la barre des tâches / Démarrer. Les raccourcis Copilot disparaissent ; réinstallable depuis le Store. Retirez avec prudence si vous utilisez vraiment Copilot.</sys:String>
  <sys:String x:Key="app.bingsearch.name">Recherche Bing</sys:String>
  <sys:String x:Key="app.bingsearch.desc">Le paquet Bing / temps forts qui injecte des résultats web dans la recherche Windows. La recherche locale reste ; les extras Bing disparaissent. Sans risque à retirer.</sys:String>
  <sys:String x:Key="app.outlook.name">Outlook (nouveau)</sys:String>
  <sys:String x:Key="app.outlook.desc">La nouvelle app Outlook pour Windows qui remplace Courrier / Calendrier sur beaucoup de PC. Si vous utilisez Outlook classique ou un autre client : Sans risque à retirer. Ne la retirez pas si c’est votre messagerie quotidienne.</sys:String>
  <sys:String x:Key="app.stickynotes.name">Notes autocollantes</sys:String>
  <sys:String x:Key="app.stickynotes.desc">Microsoft Sticky Notes. Elles restent en arrière-plan. Sans risque à retirer. Restauration via le Store / le compte Microsoft.</sys:String>
  <sys:String x:Key="app.powerautomate.name">Power Automate</sys:String>
  <sys:String x:Key="app.powerautomate.desc">Automatisation / flux de bureau livrés avec Windows. Inutile. Sans risque à retirer.</sys:String>
  <sys:String x:Key="app.devhome.name">Dev Home</sys:String>
  <sys:String x:Key="app.devhome.desc">Le tableau de bord développeur Microsoft (widgets, préparation du PC). Sans risque à retirer. Windows 11 uniquement.</sys:String>
  <sys:String x:Key="app.xboxtcui.name">Xbox TCUI</sys:String>
  <sys:String x:Key="app.xboxtcui.desc">Interface Xbox utilisée par Game Bar / les pop-ups Game Pass. Certaines invites Xbox en jeu peuvent casser. Gardez-la si vous conservez Game Bar ou Game Pass.</sys:String>
  <sys:String x:Key="app.xboxspeech.name">Superposition vocale Xbox</sys:String>
  <sys:String x:Key="app.xboxspeech.desc">Superposition dictée de Xbox Game Bar. Sans risque à retirer. Gardez-la si vous utilisez l’accessibilité Xbox.</sys:String>
  <sys:String x:Key="app.family.name">Microsoft Family</sys:String>
  <sys:String x:Key="app.family.desc">Sécurité familiale / contrôle parental. Sans risque à retirer. Microsoft Store.</sys:String>
  <sys:String x:Key="app.startexperiences.name">Expériences Démarrer</sys:String>
  <sys:String x:Key="app.startexperiences.desc">Recommandations du menu Démarrer / applications suggérées sous Windows 11. Certaines suggestions Démarrer disparaissent. Retirez avec prudence — Démarrer fonctionne encore, les recommandations changent.</sys:String>
