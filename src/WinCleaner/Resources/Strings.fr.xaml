  <sys:String x:Key="tools.subtitle">Nettoyage, réparation et maintenance. Les éléments risqués sont marqués en rouge/jaune — lisez avant de les lancer.</sys:String>
  <sys:String x:Key="tools.maintenance">Maintenance &amp; réparation</sys:String>
