  <sys:String x:Key="svc.title">Services</sys:String>
  <sys:String x:Key="svc.subtitle">Petits programmes que Windows laisse tourner en arrière-plan. Désactiver ceux dont vous n’avez pas besoin allège le PC. Interrupteur = Désactivé.</sys:String>
