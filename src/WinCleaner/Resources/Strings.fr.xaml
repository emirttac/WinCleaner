  <sys:String x:Key="app.camera.name">Camera</sys:String>
  <sys:String x:Key="app.camera.desc">Webcam capture app.</sys:String>
  <sys:String x:Key="tweak.feathyperv.name">Enable Hyper-V</sys:String>
  <sys:String x:Key="tweak.feathyperv.desc">Enables the Hyper-V optional feature set. Requires reboot. Caution: may conflict with other hypervisors (VMware/VirtualBox). (disable feature).</sys:String>
  <sys:String x:Key="tweak.featwsl.name">Enable WSL + Virtual Machine Platform</sys:String>
  <sys:String x:Key="tweak.featwsl.desc">Enables Windows Subsystem for Linux and Virtual Machine Platform. Requires reboot.</sys:String>
  <sys:String x:Key="tweak.featsandbox.name">Enable Windows Sandbox</sys:String>
  <sys:String x:Key="tweak.featsandbox.desc">Enables Windows Sandbox (Pro/Enterprise). Requires reboot.</sys:String>
  <sys:String x:Key="tweak.featdotnet.name">Enable .NET Framework 2/3/4 Features</sys:String>
  <sys:String x:Key="tweak.featdotnet.desc">Enables NetFx3 / NetFx4 advanced services for legacy apps. May download from Windows Update.</sys:String>
  <sys:String x:Key="tweak.featmedia.name">Enable Legacy Media Components</sys:String>
  <sys:String x:Key="tweak.featmedia.desc">Enables Windows Media Player, DirectPlay, and legacy components.</sys:String>
  <sys:String x:Key="tweak.featnfs.name">Enable NFS Client</sys:String>
  <sys:String x:Key="tweak.featnfs.desc">Enables Client for NFS optional features. Caution: only needed for NFS shares.</sys:String>
  <sys:String x:Key="tweak.featf8.name">Enable Legacy F8 Boot Menu</sys:String>
  <sys:String x:Key="tweak.featf8.desc">Sets bootmenupolicy=legacy so F8 Advanced Boot Options work. Requires reboot.</sys:String>
  <sys:String x:Key="tweak.wurecommended.name">Recommended Windows Update Deferrals</sys:String>
  <sys:String x:Key="tweak.wurecommended.desc">Defers feature updates 365 days, quality updates 4 days, excludes WU drivers, sets AU notify-before-install. Caution: You stay responsible for security updates. (policy values removed).</sys:String>
