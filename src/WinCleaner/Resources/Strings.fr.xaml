  <sys:String x:Key="win11.subtitle">Réglages UI et confidentialité spécifiques à Windows 11 : menu contextuel classique, Copilot/Recall, recommandations du menu Démarrer et Widgets.</sys:String>
  <sys:String x:Key="net.title">Optimisation réseau</sys:String>
  <sys:String x:Key="net.subtitle">Paramètres DNS, NetBIOS et bande passante — pour le ping et la résolution de noms en jeu en ligne.</sys:String>
