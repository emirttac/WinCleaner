  <sys:String x:Key="svc.title">Servicii</sys:String>
  <sys:String x:Key="svc.subtitle">Programe mici pe care Windows le ține active în fundal. Dezactivarea celor de care nu aveți nevoie lasă PC-ul să respire mai ușor. Comutator = Dezactivat.</sys:String>
  <sys:String x:Key="svc.startType">Tip pornire</sys:String>
