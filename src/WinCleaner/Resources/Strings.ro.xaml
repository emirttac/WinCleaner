  <sys:String x:Key="svc.stopped">Oprit</sys:String>
  <sys:String x:Key="tel.title">Telemetrie &amp; confidențialitate</sys:String>
  <sys:String x:Key="tel.subtitle">Reduce ce urmărește și raportează Windows către Microsoft. Nu va crește magic FPS-ul în jocuri; este în principal pentru confidențialitate și mai puțină încărcare în fundal.</sys:String>
  <sys:String x:Key="blo.title">Bloatware</sys:String>
  <sys:String x:Key="blo.subtitle">Aplicații preinstalate pe care majoritatea oamenilor nu le deschid niciodată. Eliminați ce nu folosiți pentru a elibera spațiu și a simplifica pornirea. Dacă eliminați una, va trebui să o reinstalați din Store.</sys:String>
  <sys:String x:Key="blo.critical">Necesar sistemului — eliminarea este dezactivată (ca să nu stricați Windows din greșeală)</sys:String>
  <sys:String x:Key="blo.onedrive">Dezinstalează OneDrive</sys:String>
  <sys:String x:Key="blo.confirm">Aplicațiile selectate vor fi eliminate definitiv. WinCleaner nu le poate aduce înapoi magic — va trebui să le reinstalați din Store. Continuați?</sys:String>
  <sys:String x:Key="blo.onedriveConfirm">Dezinstalați complet OneDrive? Sincronizarea folderului din cloud se va opri. Va trebui să confirmați de două ori.</sys:String>
  <sys:String x:Key="gam.title">Optimizări pentru jocuri</sys:String>
  <sys:String x:Key="gam.subtitle">Setări pentru FPS, latență și zgomot de fundal. Nu așteptați miracole — un PC bun plus aceste ajustări înseamnă performanță mai curată.</sys:String>
  <sys:String x:Key="gam.tips">Sfaturi monitor &amp; V-Sync</sys:String>
  <sys:String x:Key="vis.title">Efecte vizuale</sys:String>
  <sys:String x:Key="vis.subtitle">Efectele frumoase ale ferestrelor (animații, transparență). Dezactivarea lor face desktopul mai simplu și mai ușor — mai ales pe PC-uri mai slabe.</sys:String>
