  <sys:String x:Key="pre.subtitle">Pachete gata făcute: aplicați multe setări dintr-odată cu un clic. Vedeți mai întâi o previzualizare, apoi confirmați.</sys:String>
  <sys:String x:Key="pre.apply">Aplică presetarea</sys:String>
  <sys:String x:Key="pre.customName">Nume profil personalizat</sys:String>
  <sys:String x:Key="set.title">Setări</sys:String>
  <sys:String x:Key="set.subtitle">Limbă, siguranță și jurnale — gestionați aici comportamentul WinCleaner</sys:String>
  <sys:String x:Key="set.language">Limbă</sys:String>
  <sys:String x:Key="set.restore">Creează un punct de restaurare la pornirea aplicației (recomandat). Modificările din sesiune nu creează puncte suplimentare.</sys:String>
  <sys:String x:Key="restore.cardTitle">Punct de restaurare a sistemului</sys:String>
  <sys:String x:Key="restore.statusNone">Nu a fost creat încă un punct de restaurare pentru această sesiune.</sys:String>
  <sys:String x:Key="restore.statusOk">Punctul de restaurare este gata pentru această sesiune.</sys:String>
  <sys:String x:Key="restore.created">Punct de restaurare creat.</sys:String>
  <sys:String x:Key="restore.failed">Nu s-a putut crea punctul de restaurare. Restaurarea sistemului poate fi dezactivată.</sys:String>
  <sys:String x:Key="restore.warnTitle">Se creează punctul de restaurare</sys:String>
  <sys:String x:Key="restore.warnBody">Poate dura aproximativ un minut. Te rugăm să aștepți — WinCleaner se deblochează la final.</sys:String>
  <sys:String x:Key="restore.creating">Se creează punctul de restaurare…</sys:String>
