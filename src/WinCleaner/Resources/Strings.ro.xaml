  <sys:String x:Key="app.stickynotes.desc">Microsoft Sticky Notes. Stau doar în fundal. Sigure de eliminat. Se pot restaura din Store / contul Microsoft.</sys:String>
  <sys:String x:Key="app.powerautomate.name">Power Automate</sys:String>
  <sys:String x:Key="app.powerautomate.desc">Automatizare desktop / fluxuri livrate cu Windows. Nu vă trebuie. Sigur de eliminat.</sys:String>
  <sys:String x:Key="app.devhome.name">Dev Home</sys:String>
  <sys:String x:Key="app.devhome.desc">Tabloul de bord pentru dezvoltatori Microsoft (widget-uri, configurare PC). Sigur de eliminat. Doar Windows 11.</sys:String>
  <sys:String x:Key="app.xboxtcui.name">Xbox TCUI</sys:String>
  <sys:String x:Key="app.xboxtcui.desc">Interfața Xbox folosită de Game Bar / ferestrele Game Pass. Unele mesaje Xbox din joc pot eșua. Lăsați-o dacă păstrați Game Bar sau Game Pass.</sys:String>
  <sys:String x:Key="app.xboxspeech.name">Overlay vocal Xbox</sys:String>
  <sys:String x:Key="app.xboxspeech.desc">Overlay-ul vorbire-în-text din Xbox Game Bar. Sigur de eliminat. Lăsați-l dacă folosiți accesibilitatea Xbox.</sys:String>
  <sys:String x:Key="app.family.name">Microsoft Family</sys:String>
  <sys:String x:Key="app.family.desc">Family Safety / control parental. Sigur de eliminat. Microsoft Store.</sys:String>
  <sys:String x:Key="app.startexperiences.name">Experiențe Start</sys:String>
  <sys:String x:Key="app.startexperiences.desc">Recomandările meniului Start / aplicații sugerate pe Windows 11. Unele sugestii Start dispar. Eliminați cu grijă — Start funcționează în continuare, se schimbă recomandările.</sys:String>
