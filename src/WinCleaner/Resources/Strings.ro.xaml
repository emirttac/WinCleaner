  <sys:String x:Key="app.bingsearch.name">Căutare Bing</sys:String>
  <sys:String x:Key="app.bingsearch.desc">Pachetul Bing / evidențieri de căutare care bagă rezultate web în Căutarea Windows. Căutarea locală rămâne; extra-urile Bing dispar. Sigur de eliminat.</sys:String>
  <sys:String x:Key="app.outlook.name">Outlook (nou)</sys:String>
