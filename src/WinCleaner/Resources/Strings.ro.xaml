  <sys:String x:Key="tools.takeOwn.name">Meniu contextual: Take Ownership</sys:String>
  <sys:String x:Key="tools.takeOwn.desc">Adaugă &quot;Take Ownership&quot; în meniurile clic-dreapta pentru fișiere și foldere (takeown + icacls). Necesită Administrator. Dezactivarea elimină cheile din meniu.</sys:String>
