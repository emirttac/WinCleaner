  <sys:String x:Key="tools.title">Instrumente de sistem</sys:String>
  <sys:String x:Key="tools.subtitle">Curățare, reparare și întreținere. Elementele riscante sunt marcate roșu/galben — citiți înainte de a le rula.</sys:String>
  <sys:String x:Key="tools.maintenance">Întreținere &amp; reparare</sys:String>
