  <sys:String x:Key="tweak.hibernation.name">Disable Hibernation</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">Oprește hibernarea și fișierul mare hiberfil.sys prin powercfg. Beneficiu: spațiu pe disc. Dezavantaj: dispare hibernarea. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.wpbt.name">Disable WPBT Execution</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">Blochează execuția încărcăturii WPBT a producătorului la pornire. Beneficiu: mai puțin software de producător care se reinstalează. Atenție: unelte OEM rare pot depinde de WPBT. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.endtask.name">End Task From Taskbar</sys:String>
  <sys:String x:Key="tweak.endtask.desc">Adaugă Închide sarcina în meniul barei Win11. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Block Device Metadata From Network</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">Oprește descărcarea metadatelor dispozitivelor. Beneficiu: mai puțin trafic de fundal. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Disable Store Search Suggestions</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">Refuză accesul Tuturor la baza locală de căutare Store. Atenție: actualizările pot reseta permisiunile. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Disable Explorer Folder Type Discovery</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">Șterge Bags/BagMRU și forțează FolderType=NotSpecified. Necesită deconectare sau repornire. Anularea este parțială.</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Unpin Explorer Home and Gallery</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">Anulează fixarea Paginii principale și a Galeriei (Win11). Nu schimbă LaunchTo. Explorer repornește. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Disable Reserved Storage</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">Dezactivează stocarea rezervată prin DISM. Beneficiu: câțiva GB. Atenție: actualizările pot cere mai mult spațiu liber. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Disable Storage Sense</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">Oprește curățarea automată a Sensorului de stocare. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">Prefer IPv4 Over IPv6</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">Setează DisabledComponents=32 ca să prefere IPv4 fără a opri IPv6. Nu combinați cu 255. Repornirea este recomandată. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.teredo.name">Disable Teredo</sys:String>
  <sys:String x:Key="tweak.teredo.desc">Dezactivează interfața de tunel Teredo IPv6 prin netsh. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.utctime.name">Hardware Clock Uses UTC</sys:String>
  <sys:String x:Key="tweak.utctime.desc">Tratează ceasul CMOS ca UTC prin RealTimeIsUniversal. Util la dual-boot cu Linux. Atenție: pe un PC doar cu Windows ora se poate deplasa. Necesită repornire. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">Disable svchost Service Splitting</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">Ridică SvcHostSplitThresholdInKB peste RAM ca serviciile să stea în mai puține procese svchost. Periculos pentru stabilitate. Necesită repornire. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Disable Notification Center and Toasts</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">Dezactivează centrul de notificări și notificările toast. Atenție: veți rata alertele. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Enable Win32 Long Paths</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">Permite căi mai lungi de 260 de caractere pentru aplicațiile compatibile. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Verbose Logon Messages</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">Arată text de stare detaliat la conectare și deconectare. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Verbose Blue Screen Details</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">Arată parametrii tehnici ai ecranului albastru și ascunde emoticonul. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.numlock.name">Num Lock On at Startup</sys:String>
  <sys:String x:Key="tweak.numlock.desc">Activează Num Lock pentru ecranul de conectare și utilizatorul curent. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Always Show Scrollbars</sys:String>
  <sys:String x:Key="tweak.scrollbars.desc">Dezactivează barele de derulare care se ascund singure. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.stickykeys.name">Disable Sticky Keys Shortcut</sys:String>
  <sys:String x:Key="tweak.stickykeys.desc">Oprește tastele adezive ca fereastra Shift să nu întrerupă jocurile. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.settingshome.name">Hide Settings Home Page</sys:String>
  <sys:String x:Key="tweak.settingshome.desc">Ascunde pagina principală și recomandările din Setări Win11. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.lockscreen.name">Disable Lock Screen</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">Sare ecranul de blocare și cere parola sau PIN-ul. Atenție: protecție fizică puțin mai slabă. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Keep Network On in Connected Standby</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">Permite rețeaua în așteptarea modernă (S0) la curent alternativ. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Prefer Classic S3 Sleep</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">Setează PlatformAoAcOverride=0 pentru somnul S3 clasic. Atenție: nu toate laptopurile îl acceptă. Necesită repornire. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Show Battery Percentage</sys:String>
  <sys:String x:Key="tweak.batterypercent.desc">Arată procentul bateriei în zona de notificare. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.loginblur.name">Disable Logon Acrylic Blur</sys:String>
  <sys:String x:Key="tweak.loginblur.desc">Dezactivează estomparea acrilică din spatele ecranului de conectare. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.windowsnap.name">Disable Window Snapping</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">Oprește Aero Snap și aranjarea ferestrelor. Util dacă alinierea deranjează jocurile sau mai multe monitoare. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.mpo.name">Disable Multiplane Overlay (MPO)</sys:String>
  <sys:String x:Key="tweak.mpo.desc">Dezactivează suprapunerile multiplan DWM (OverlayTestMode=5). Util la ecran negru sau sacadări. Necesită repornire. Se poate anula: da.</sys:String>
