  <sys:String x:Key="tweak.featdotnet.name">Enable .NET Framework 2/3/4 Features</sys:String>
  <sys:String x:Key="tweak.featdotnet.desc">Activează serviciile NetFx3 / NetFx4 pentru aplicații vechi. Poate descărca din Windows Update. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.featmedia.name">Enable Legacy Media Components</sys:String>
  <sys:String x:Key="tweak.featmedia.desc">Activează Windows Media Player, DirectPlay și componente vechi. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.featnfs.name">Enable NFS Client</sys:String>
  <sys:String x:Key="tweak.featnfs.desc">Activează funcțiile opționale ale clientului NFS. Atenție: necesar doar pentru partajări NFS. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.featf8.name">Enable Legacy F8 Boot Menu</sys:String>
  <sys:String x:Key="tweak.featf8.desc">Setează bootmenupolicy=legacy ca F8 să funcționeze. Necesită repornire. Se poate anula: da.</sys:String>
  <sys:String x:Key="tweak.wurecommended.name">Recommended Windows Update Deferrals</sys:String>
  <sys:String x:Key="tweak.wurecommended.desc">Amână actualizările de caracteristici 365 de zile și pe cele de calitate 4 zile, exclude driverele WU și anunță înainte de instalare. Atenție: actualizările de securitate rămân responsabilitatea dvs. Se poate anula: da.</sys:String>
