  <sys:String x:Key="inst.acrobat.name">Adobe Acrobat Reader</sys:String>
  <sys:String x:Key="inst.acrobat.desc">Lector de PDF (64 bits).</sys:String>
  <sys:String x:Key="preset.gamer.name">Modo Gamer</sys:String>
  <sys:String x:Key="preset.gamer.desc">Un paquete: Game Mode, Game Bar/DVR desactivados, plan de energía, MMCSS, simplificación visual, reducción de telemetría, SysMain apagado y ajustes similares.&#x0a;Para: PCs gaming. Lee primero la lista de vista previa y luego aplica.</sys:String>
  <sys:String x:Key="preset.balanced.name">Modo equilibrado</sys:String>
  <sys:String x:Key="preset.balanced.desc">Toque ligero: Game Mode más privacidad básica. Sin apagado agresivo de servicios.&#x0a;Para: &quot;Quiero un poco de optimización pero no quiero romper Windows&quot;.</sys:String>
  <sys:String x:Key="preset.minimal.name">Modo mínimo / servidor</sys:String>
  <sys:String x:Key="preset.minimal.desc">Lo más austero posible: telemetría, animaciones, apps en segundo plano, servicios innecesarios…&#x0a;Para: Segundo PC, HTPC o máquinas de &quot;solo trabajar&quot;. Prueba primero Gamer en tu PC gaming principal.</sys:String>
  <sys:String x:Key="preset.laptop.name">Modo portátil / batería</sys:String>
  <sys:String x:Key="preset.laptop.desc">Omite ajustes agresivos de energía para juegos (Rendimiento máximo, core parking desactivado); se centra en reducir telemetría, simplificar lo visual y limitar apps en segundo plano — un perfil equilibrado para portátiles.&#x0a;Para: Notebooks donde importa la autonomía.</sys:String>
  <sys:String x:Key="preset.privacymax.name">Privacidad máxima</sys:String>
  <sys:String x:Key="preset.privacymax.desc">Más agresivo que Equilibrado, pero no tan cargado de servicios como Mínimo: aplica juntos ajustes de telemetría, ubicación, ID de publicidad y personalización en un perfil centrado en la privacidad.</sys:String>
  <sys:String x:Key="preset.defaults.name">Restaurar valores predeterminados (deshacer sesión)</sys:String>
  <sys:String x:Key="preset.defaults.desc">Revierte los cambios reversibles de esta sesión de WinCleaner (Deshacer todo).&#x0a;Nota: Las apps eliminadas no vuelven — reinstálalas desde la Store.</sys:String>
