  <sys:String x:Key="tools.title">Herramientas del sistema</sys:String>
  <sys:String x:Key="tools.subtitle">Limpieza, reparación y mantenimiento. Los elementos riesgosos están marcados en rojo/amarillo: léelos antes de ejecutarlos.</sys:String>
  <sys:String x:Key="tools.maintenance">Mantenimiento y reparación</sys:String>
