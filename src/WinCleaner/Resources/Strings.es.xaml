  <sys:String x:Key="tel.title">Telemetría y privacidad</sys:String>
  <sys:String x:Key="tel.subtitle">Reduce lo que Windows rastrea y envía a Microsoft. No aumentará mágicamente los FPS; es principalmente privacidad y menos carga en segundo plano.</sys:String>
  <sys:String x:Key="blo.title">Bloatware</sys:String>
  <sys:String x:Key="blo.subtitle">Apps preinstaladas que casi nadie abre. Quita las que no uses para liberar espacio y simplificar el inicio. Si eliminas una, deberás reinstalarla desde la Store.</sys:String>
  <sys:String x:Key="blo.critical">Requerido por el sistema — eliminación deshabilitada (para que no rompas Windows por accidente)</sys:String>
  <sys:String x:Key="blo.onedrive">Desinstalar OneDrive</sys:String>
  <sys:String x:Key="blo.confirm">Las apps seleccionadas se eliminarán de forma permanente. WinCleaner no puede recuperarlas mágicamente: deberás reinstalarlas desde la Store. ¿Continuar?</sys:String>
  <sys:String x:Key="blo.onedriveConfirm">¿Desinstalar OneDrive por completo? Se detendrá la sincronización de la carpeta en la nube. Deberás confirmar dos veces.</sys:String>
  <sys:String x:Key="gam.title">Optimizaciones para gamers</sys:String>
  <sys:String x:Key="gam.subtitle">Ajustes de FPS, latencia y ruido en segundo plano. No esperes milagros: un buen PC más estos tweaks dan un rendimiento más limpio.</sys:String>
  <sys:String x:Key="gam.tips">Consejos de monitor y V-Sync</sys:String>
  <sys:String x:Key="vis.title">Efectos visuales</sys:String>
  <sys:String x:Key="vis.subtitle">Los efectos vistosos de las ventanas (animaciones, transparencia). Desactivarlos hace el escritorio más simple y ligero, sobre todo en PCs modestos.</sys:String>
  <sys:String x:Key="vis.startup">Programas de inicio</sys:String>
  <sys:String x:Key="vis.pagefile">Abrir configuración de memoria virtual</sys:String>
  <sys:String x:Key="win11.title">Windows 11 &amp; UI</sys:String>
  <sys:String x:Key="win11.subtitle">Ajustes de interfaz y privacidad específicos de Windows 11: menú contextual clásico, Copilot/Recall, recomendaciones del Inicio y Widgets.</sys:String>
  <sys:String x:Key="net.title">Optimización de red</sys:String>
  <sys:String x:Key="net.subtitle">Ajustes de DNS, NetBIOS y ancho de banda — para ping y resolución de nombres en juegos en línea.</sys:String>
  <sys:String x:Key="net.tweaks">Ajustes de red</sys:String>
  <sys:String x:Key="net.dns.title">Cambio rápido de DNS</sys:String>
  <sys:String x:Key="net.dns.desc">Cambia los servidores DNS en adaptadores con IP habilitada y luego ejecuta flushdns automáticamente. Requiere administrador.</sys:String>
