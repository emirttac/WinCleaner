  <sys:String x:Key="svc.title">Servicios</sys:String>
  <sys:String x:Key="svc.subtitle">Pequeños programas que Windows mantiene en segundo plano. Desactivar los que no necesitas deja respirar al PC. Interruptor = Desactivado.</sys:String>
