  <sys:String x:Key="svc.title">Servisler</sys:String>
  <sys:String x:Key="svc.subtitle">Windows’un arka planda sürekli çalıştırdığı küçük programlar. Gereksiz olanları kapatınca bilgisayar daha rahat nefes alır. Anahtar = Devre dışı.</sys:String>
  <sys:String x:Key="svc.startType">Başlangıç Türü</sys:String>
  <sys:String x:Key="svc.running">Çalışıyor</sys:String>
