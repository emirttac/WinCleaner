<Window x:Class="WinCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinCleaner.ViewModels"
        Title="{Binding AppTitle}"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
          <TextBlock Text="WinCleaner" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}"/>
          <TextBlock Text="{Binding OsBanner}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
          <Button Content="{Binding UndoLabel}" Command="{Binding UndoAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- IsChecked bound to SelectedNav — no Command (avoids re-entrancy crashes on tab switch) -->
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavDashboard}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=dashboard, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavServices}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=services, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavTelemetry}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=telemetry, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavBloatware}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=bloatware, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavGaming}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=gaming, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavVisual}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=visual, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavWin11}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=win11, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavNetwork}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=network, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavTools}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=tools, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavInstaller}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=installer, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavPresets}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=presets, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource SidebarButtonStyle}" Content="{Binding NavSettings}" GroupName="nav"
                         IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=settings, Mode=TwoWay}"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" Padding="20,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBox Style="{StaticResource SearchBoxStyle}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding SearchPlaceholder}" IsHitTestVisible="False"
                     Foreground="{StaticResource TextMutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center"
                     Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
        </Grid>
      </Border>

      <!-- ContentControl is NOT inside ScrollViewer (layout measure crashes on rapid template swaps) -->
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24"/>
    </Grid>
  </Grid>
</Window>
