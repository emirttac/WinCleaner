<Application x:Class="WinCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinCleaner.ViewModels"
             xmlns:views="clr-namespace:WinCleaner.Views"
             xmlns:conv="clr-namespace:WinCleaner.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/DarkRed.xaml"/>
        <ResourceDictionary Source="Resources/SocialIcons.xaml"/>
        <ResourceDictionary Source="Resources/Strings.tr.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <conv:RiskToBrushConverter x:Key="RiskToBrush"/>
      <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
      <conv:NavEqualsConverter x:Key="NavEq"/>

      <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
        <views:ServicesView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:TweaksCategoryViewModel}">
        <views:TweaksView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:BloatwareViewModel}">
        <views:BloatwareView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:VisualViewModel}">
        <views:VisualView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
        <views:NetworkView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <views:ToolsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PackageInstallerViewModel}">
        <views:PackageInstallerView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PresetsViewModel}">
        <views:PresetsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView/>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
