<UserControl x:Class="WinCleaner.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>

    <Border Style="{StaticResource CardBorderStyle}">
      <StackPanel>
        <TextBlock Text="{DynamicResource set.language}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberPath="DisplayName"
                  Width="220"
                  HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource set.restore}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding AutoRestorePoint, Mode=TwoWay}"/>
      </Grid>
    </Border>

    <Border Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource set.dangerous}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding AllowDangerous, Mode=TwoWay}"/>
      </Grid>
    </Border>

    <Border Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource set.updates}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding CheckUpdates, Mode=TwoWay}"/>
      </Grid>
    </Border>

    <Border Style="{StaticResource CardBorderStyle}">
      <StackPanel>
        <TextBlock Text="{DynamicResource set.logs}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox Text="{Binding LogFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBoxStyle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="{DynamicResource common.save}" Command="{Binding SaveLogFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource set.openFolder}" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource set.exportReport}" Command="{Binding ExportChangeReportCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Social links -->
    <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,16">
      <StackPanel>
        <TextBlock Text="{DynamicResource set.social.title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource set.social.subtitle}"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>
        <WrapPanel>
          <Button Style="{StaticResource SocialLinkButtonStyle}"
                  Command="{Binding OpenSocialCommand}"
                  CommandParameter="youtube"
                  ToolTip="https://www.youtube.com/@BiAltTab">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource YouTubeLogo}" Width="22" Height="22" Margin="0,0,10,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource set.social.youtube}" FontWeight="SemiBold"/>
                <TextBlock Text="@BiAltTab" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button Style="{StaticResource SocialLinkButtonStyle}"
                  Command="{Binding OpenSocialCommand}"
                  CommandParameter="instagram"
                  ToolTip="https://www.instagram.com/emirttac/">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource InstagramLogo}" Width="22" Height="22" Margin="0,0,10,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource set.social.instagram}" FontWeight="SemiBold"/>
                <TextBlock Text="@emirttac" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button Style="{StaticResource SocialLinkButtonStyle}"
                  Command="{Binding OpenSocialCommand}"
                  CommandParameter="github"
                  ToolTip="https://github.com/emirttac">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource GitHubLogo}" Width="22" Height="22" Margin="0,0,10,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource set.social.github}" FontWeight="SemiBold"/>
                <TextBlock Text="emirttac" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
