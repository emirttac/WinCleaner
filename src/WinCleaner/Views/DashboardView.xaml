<UserControl x:Class="WinCleaner.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>

    <Border Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="{Binding RestoreCardTitle}" Style="{StaticResource CardTitleStyle}"/>
          <TextBlock Text="{Binding RestoreStatusText}" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="12"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding CreateRestoreLabel}"
                Command="{Binding CreateRestoreCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                VerticalAlignment="Center"
                IsEnabled="{Binding CanRunQuickActions}"/>
      </Grid>
    </Border>

    <UniformGrid Columns="2">
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
        <StackPanel>
          <TextBlock Text="CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
          <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" FontSize="15" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="GPU" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
          <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" FontSize="15" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
        <StackPanel>
          <TextBlock Text="RAM" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
          <TextBlock Text="{Binding RamText}" FontSize="15" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="OS" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
          <TextBlock Text="{Binding OsText}" FontSize="15" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Style="{StaticResource CardBorderStyle}">
      <StackPanel>
        <TextBlock Text="Disks" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
        <TextBlock Text="{Binding DiskText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding QuickTitle}" Style="{StaticResource SectionHeaderStyle}"/>
    <StackPanel Orientation="Horizontal">
      <Button Content="{Binding ApplyGamerLabel}" Command="{Binding ApplyGamerCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
              IsEnabled="{Binding CanRunQuickActions}"/>
      <Button Content="{Binding FlushDnsLabel}" Command="{Binding FlushDnsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
              IsEnabled="{Binding CanRunQuickActions}"/>
      <Button Content="{Binding CleanTempLabel}" Command="{Binding CleanTempCommand}" Style="{StaticResource SecondaryButtonStyle}"
              IsEnabled="{Binding CanRunQuickActions}"/>
    </StackPanel>

    <TextBlock Text="{Binding RecentTitle}" Style="{StaticResource SectionHeaderStyle}"/>
    <TextBlock Text="{Binding RecentEmpty}"
               Foreground="{StaticResource TextMutedBrush}"
               Visibility="{Binding HasRecentChanges, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
               Margin="0,0,0,8"/>
    <ItemsControl ItemsSource="{Binding RecentChanges}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
  </ScrollViewer>
</UserControl>
