<Window x:Class="WinCleaner.Views.TimeMachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Machine"
        Height="520" Width="760"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPanelBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"/>
      <TextBlock x:Name="SubtitleText" Margin="0,4,0,12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.42*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="0.58*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="8">
        <ListBox x:Name="SnapshotList" Background="Transparent" BorderThickness="0"
                 DisplayMemberPath="Label" SelectionChanged="SnapshotList_SelectionChanged"/>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="8">
        <DockPanel>
          <TextBlock x:Name="EmptyDetail" DockPanel.Dock="Top"
                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{Binding RevertLabel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4" FontSize="11"
                            Command="{Binding RevertCommand}"
                            IsEnabled="{Binding CanRevert}"/>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RevertSnapshotButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
              Click="RevertSnapshot_Click"/>
      <Button x:Name="CloseButton" Style="{StaticResource SecondaryButtonStyle}"
              IsCancel="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
