<UserControl x:Class="WinCleaner.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>

      <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
          <TextBlock Text="{Binding DnsTitle}" Style="{StaticResource CardTitleStyle}"/>
          <TextBlock Text="{Binding DnsDescription}" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,12" FontSize="12"/>
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding DnsOptions}"
                      SelectedItem="{Binding SelectedDnsOption}"
                      DisplayMemberPath="DisplayName"
                      Width="320" MinHeight="32"
                      VerticalContentAlignment="Center"
                      IsEnabled="{Binding CanChangeDns}"/>
            <Button Content="{Binding DnsApplyLabel}" Command="{Binding ApplyDnsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                    IsEnabled="{Binding CanChangeDns}"/>
            <Button Content="{Binding FlushDnsLabel}" Command="{Binding FlushDnsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    IsEnabled="{Binding CanChangeDns}"/>
          </StackPanel>
          <TextBlock Text="{Binding DnsStatus}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding TweaksSectionTitle}" Style="{StaticResource SectionHeaderStyle}"/>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardBorderStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}"/>
                    <Border Background="{Binding Risk, Converter={StaticResource RiskToBrush}}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding RiskLabel}" FontSize="10" Foreground="#111"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                             FontSize="12" LineHeight="18"
                             ToolTip="{Binding Description}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}"
                              IsChecked="{Binding IsApplied, Mode=OneWay}"
                              IsEnabled="{Binding IsEnabled}"
                              Command="{Binding ToggleCommand}"
                              VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0"
              Visibility="{Binding Tips, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding Tips}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
