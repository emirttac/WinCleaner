<UserControl x:Class="WinCleaner.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>

    <TextBlock Text="{Binding MaintenanceTitle}" Style="{StaticResource SectionHeaderStyle}"/>
    <WrapPanel Margin="0,0,0,8">
      <Button Content="{Binding CleanTempLabel}" Command="{Binding CleanTempCommand}"
              Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding DiskCleanupLabel}" Command="{Binding OpenDiskCleanupCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding SfcDismLabel}" Command="{Binding RunSfcDismRepairCommand}"
              Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding WinsxsLabel}" Command="{Binding RunWinsxsCleanupCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding GodModeLabel}" Command="{Binding CreateGodModeCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding WuResetLabel}" Command="{Binding ResetWindowsUpdateCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding NetworkResetLabel}" Command="{Binding ResetNetworkStackCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding MemoryDiagLabel}" Command="{Binding OpenMemoryDiagnosticCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
      <Button Content="{Binding DiskAnalyzeLabel}" Command="{Binding AnalyzeDiskSpaceCommand}"
              Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
              IsEnabled="{Binding CanRunTools}"/>
    </WrapPanel>

    <Border Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding TakeOwnTitle}" Style="{StaticResource CardTitleStyle}"/>
          <TextBlock Text="{Binding TakeOwnDescription}" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="12"/>
        </StackPanel>
        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}"
                      IsChecked="{Binding TakeOwnershipEnabled, Mode=OneWay}"
                      IsEnabled="{Binding CanRunTools}"
                      Command="{Binding ToggleTakeOwnershipCommand}"
                      VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <TextBlock Text="{Binding TweaksSectionTitle}" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0"/>
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}"/>
                  <Border Background="{Binding Risk, Converter={StaticResource RiskToBrush}}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                    <TextBlock Text="{Binding RiskLabel}" FontSize="10" Foreground="#111"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                           FontSize="12" LineHeight="18"
                           ToolTip="{Binding Description}"/>
              </StackPanel>
              <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggleStyle}"
                            IsChecked="{Binding IsApplied, Mode=OneWay}"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding ToggleCommand}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
  </ScrollViewer>
</UserControl>
