<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:String x:Key="Theme.Kind">Light</sys:String>

  <Color x:Key="BgDeepColor">#F4F4F5</Color>
  <Color x:Key="BgPanelColor">#FFFFFF</Color>
  <Color x:Key="BgElevatedColor">#F0F0F2</Color>
  <Color x:Key="BgHoverColor">#E4E4E8</Color>
  <Color x:Key="AccentColor">#E10600</Color>
  <Color x:Key="AccentBrightColor">#C10500</Color>
  <Color x:Key="AccentDimColor">#8B0400</Color>
  <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
  <Color x:Key="TextSecondaryColor">#3D3D3D</Color>
  <Color x:Key="TextMutedColor">#595959</Color>
  <Color x:Key="BorderColor">#767676</Color>
  <Color x:Key="WarningColor">#B86E00</Color>
  <Color x:Key="DangerColor">#C6281C</Color>
  <Color x:Key="SuccessColor">#0B7A3B</Color>
  <Color x:Key="FocusColor">#E10600</Color>
  <Color x:Key="BadgeOnSuccessColor">#FFFFFF</Color>
  <Color x:Key="BadgeOnWarningColor">#111111</Color>
  <Color x:Key="BadgeOnDangerColor">#FFFFFF</Color>
  <Color x:Key="BadgeOnMutedColor">#FFFFFF</Color>
  <Color x:Key="OnAccentColor">#FFFFFF</Color>
  <Color x:Key="NavSelectedColor">#F8E6E6</Color>
  <Color x:Key="ToggleTrackColor">#D0D0D4</Color>
  <Color x:Key="ToggleThumbColor">#1A1A1A</Color>

  <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}"/>
  <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
  <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}"/>
  <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}"/>
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
  <SolidColorBrush x:Key="BadgeOnSuccessBrush" Color="{StaticResource BadgeOnSuccessColor}"/>
  <SolidColorBrush x:Key="BadgeOnWarningBrush" Color="{StaticResource BadgeOnWarningColor}"/>
  <SolidColorBrush x:Key="BadgeOnDangerBrush" Color="{StaticResource BadgeOnDangerColor}"/>
  <SolidColorBrush x:Key="BadgeOnMutedBrush" Color="{StaticResource BadgeOnMutedColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
  <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}"/>
  <SolidColorBrush x:Key="ToggleTrackBrush" Color="{StaticResource ToggleTrackColor}"/>
  <SolidColorBrush x:Key="ToggleThumbBrush" Color="{StaticResource ToggleThumbColor}"/>

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E10600" Offset="0"/>
    <GradientStop Color="#C10500" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
