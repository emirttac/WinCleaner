  <sys:String x:Key="tweak.windowsnap.name">Pencere Yapıştırmayı Kapat</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">Aero Snap / pencere yerleştirme’yi kapatır. Yapıştırma oyununu veya çoklu monitör düzenini bozuyorsa işe yarar.</sys:String>
