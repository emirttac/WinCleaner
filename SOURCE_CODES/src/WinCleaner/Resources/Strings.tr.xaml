  <sys:String x:Key="tweak.hibernation.name">Hazırda Bekletmeyi Kapat</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">Hazırda bekletmeyi kapatır ve büyük hiberfil.sys dosyasını siler. Disk açılır; hibernate / hybrid sleep kaybolur.</sys:String>
  <sys:String x:Key="tweak.wpbt.name">WPBT Çalıştırmayı Devre Dışı Bırak</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">Açılışta OEM WPBT yüklerinin çalışmasını engeller; bazı üretici şişkinlikleri kendini yeniden kuramaz. Nadir OEM araçları buna bağlı olabilir.</sys:String>
  <sys:String x:Key="tweak.endtask.name">Görev Çubuğundan Görevi Sonlandır</sys:String>
  <sys:String x:Key="tweak.endtask.desc">Windows 11 görev çubuğu uygulama menüsüne Görevi sonlandır ekler.</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Ağdan Cihaz Meta Verisini Engelle</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">Windows’un internetten cihaz yardımcı meta verisi indirmesini keser; arka plan ağ gürültüsü azalır.</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Store Arama Önerilerini Kapat</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">Microsoft Store yerel arama veritabanına erişimi keser (WinUtil tarzı). Kırılgan — Store güncellemesi sıfırlayabilir, Store araması bozulabilir.</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Explorer Klasör Tipi Keşfini Kapat</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">Explorer’ın klasör şablonlarını otomatik tahmin etmesini keser (Bags/BagMRU temizliği). Oturumu kapatma veya yeniden başlatma gerekir; geri alma kısmen yeniden temizler.</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Explorer Ana Sayfa ve Galeriyi Kaldır</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">Windows 11 Explorer kenar çubuğundan Ana sayfa ve Galeri’yi kaldırır. Bu Bilgisayar ile açmayı ayrıca ayarla. Explorer yeniden başlar.</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Ayrılmış Depolamayı Kapat</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">DISM ile Windows Ayrılmış Depolama’yı kapatır; birkaç GB geri gelebilir. Sonraki güncellemeler daha fazla boş alan isteyebilir.</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Depolama Algısını Kapat</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">Depolama Algısı otomatik temizliğini kapatır.</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">IPv4'ü IPv6'ya Tercih Et</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">IPv6’yı tamamen kapatmadan Windows’un IPv4’ü tercih etmesini sağlar. IPv6’yı kapat ile birlikte kullanma — birini seç. Yeniden başlatma önerilir.</sys:String>
  <sys:String x:Key="tweak.teredo.name">Teredo'yu Kapat</sys:String>
  <sys:String x:Key="tweak.teredo.desc">netsh ile Teredo IPv6 tünel arayüzünü kapatır.</sys:String>
  <sys:String x:Key="tweak.utctime.name">Donanım Saati UTC Kullansın</sys:String>
  <sys:String x:Key="tweak.utctime.desc">Donanım saatini UTC sayar (Linux ile çift boot için işe yarar). Sadece Windows’lu PC’lerde saat kayabilir. Yeniden başlatma gerekir.</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">svchost Bölünmesini Kapat</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">Servisleri daha az svchost sürecinde gruplar. Tehlikeli — kararsızlık daha fazla servisi birden düşürebilir. Yeniden başlatma gerekir.</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Bildirim Merkezi ve Toast'ları Kapat</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">Bildirim Merkezi ve toast bildirimlerini kapatır. Sistem ve uygulama uyarılarını kaçırırsın.</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Uzun Dosya Yollarını Aç</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">Uyumlu uygulamalar için 260 karakterden uzun yollara izin verir.</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Ayrıntılı Oturum Açma Mesajları</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">Oturum açarken / kapatırken ayrıntılı durum metni gösterir.</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Ayrıntılı Mavi Ekran</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">Mavi ekranda teknik ayrıntıları gösterir ve üzgün yüz emojisini kapatır.</sys:String>
  <sys:String x:Key="tweak.numlock.name">Başlangıçta Num Lock Açık</sys:String>
  <sys:String x:Key="tweak.numlock.desc">Oturum açma ekranı ve geçerli kullanıcı için Num Lock’u açık getirir.</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Kaydırma Çubuklarını Her Zaman Göster</sys:String>
