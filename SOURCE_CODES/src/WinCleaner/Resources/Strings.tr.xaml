  <sys:String x:Key="pre.subtitle">Hazır paketler: tek tıkla birçok ayarı birlikte uygular. Önce önizleme görürsün, sonra onaylarsın.</sys:String>
  <sys:String x:Key="pre.apply">Preset Uygula</sys:String>
  <sys:String x:Key="pre.customName">Özel profil adı</sys:String>
  <sys:String x:Key="set.title">Ayarlar</sys:String>
  <sys:String x:Key="set.subtitle">Dil, güvenlik ve günlükler — WinCleaner’ın kendi davranışını buradan yönetirsin</sys:String>
  <sys:String x:Key="set.language">Dil</sys:String>
  <sys:String x:Key="set.restore">Uygulama açılırken bir geri yükleme noktası oluştur (önerilir). Oturum sırasındaki işlemler için ek nokta oluşturulmaz.</sys:String>
  <sys:String x:Key="restore.cardTitle">Sistem Geri Yükleme Noktası</sys:String>
  <sys:String x:Key="restore.statusNone">Bu oturum için henüz geri yükleme noktası oluşturulmadı.</sys:String>
  <sys:String x:Key="restore.statusOk">Bu oturum için geri yükleme noktası hazır.</sys:String>
  <sys:String x:Key="restore.created">Geri yükleme noktası oluşturuldu.</sys:String>
  <sys:String x:Key="restore.failed">Geri yükleme noktası oluşturulamadı. Sistem Geri Yükleme kapalı olabilir.</sys:String>
  <sys:String x:Key="restore.warnTitle">Geri yükleme noktası oluşturuluyor</sys:String>
  <sys:String x:Key="restore.warnBody">Bu işlem yaklaşık bir dakika sürebilir. Lütfen bekleyin — tamamlanınca WinCleaner açılacak.</sys:String>
  <sys:String x:Key="restore.creating">Geri yükleme noktası oluşturuluyor…</sys:String>
