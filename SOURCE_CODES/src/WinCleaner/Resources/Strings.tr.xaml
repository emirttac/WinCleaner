  <sys:String x:Key="tweak.lockscreen.name">Kilit Ekranını Kapat</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">Kilit ekranını atlayıp doğrudan parola/PIN ekranına gider. PC’ye fiziksel erişimi olan biri için biraz daha zayıf kalır.</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Bağlı Beklemede Ağı Açık Tut</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">Modern Bekleme (S0) sırasında, prize takılıyken ağ bağlantısına izin verir.</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Klasik S3 Uykuyu Tercih Et</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">Destekleyen donanımda klasik S3 uykuyu tercih eder. Her modern laptop desteklemez; yeniden başlatma gerekir.</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Pil Yüzdesini Göster</sys:String>
