  <sys:String x:Key="tools.diskAnalyze">Disk Alanı Analizi</sys:String>
  <sys:String x:Key="tools.desc.restore">Değişiklikten önce bir Windows geri yükleme noktası oluşturur.</sys:String>
  <sys:String x:Key="tools.desc.cleanTemp">Windows ve kullanıcı geçici dosyalarını siler.</sys:String>
  <sys:String x:Key="tools.desc.diskCleanup">Yerleşik Disk Temizleme aracını açar.</sys:String>
  <sys:String x:Key="tools.desc.sfcDism">Sistem dosyalarını onarır; uzun sürebilir.</sys:String>
  <sys:String x:Key="tools.desc.winsxs">Eski Windows Update bileşenlerini temizler; sonra geri almak zorlaşır.</sys:String>
  <sys:String x:Key="tools.desc.godMode">Masaüstüne tüm Denetim Masası öğelerine giden bir kısayol oluşturur.</sys:String>
  <sys:String x:Key="tools.desc.wuReset">Windows Update servislerini ve önbelleklerini sıfırlar.</sys:String>
  <sys:String x:Key="tools.desc.networkReset">Winsock/IP yığınını sıfırlar; ardından yeniden başlatman önerilir.</sys:String>
