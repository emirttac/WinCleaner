  <sys:String x:Key="app.devhome.name">Dev Home</sys:String>
  <sys:String x:Key="app.devhome.desc">Microsoft’un geliştirici paneli. Kullanmıyorsan güvenle kaldırılır (Windows 11).</sys:String>
  <sys:String x:Key="app.xboxtcui.name">Xbox TCUI</sys:String>
  <sys:String x:Key="app.xboxtcui.desc">Game Bar / Game Pass pencerelerinde kullanılan Xbox arayüzü. Game Bar veya Game Pass tutuyorsan bırak.</sys:String>
  <sys:String x:Key="app.xboxspeech.name">Xbox konuşma katmanı</sys:String>
  <sys:String x:Key="app.xboxspeech.desc">Xbox Game Bar konuşmayı yazıya çevirme katmanı. Oyun içi sesli altyazı kullanmıyorsan kaldırabilirsin.</sys:String>
  <sys:String x:Key="app.family.name">Microsoft Aile</sys:String>
  <sys:String x:Key="app.family.desc">Aile Güvenliği / ebeveyn kontrolü uygulaması. Bu PC’de çocuk hesabı yönetmiyorsan güvenle kaldırılır.</sys:String>
  <sys:String x:Key="app.startexperiences.name">Başlat deneyimleri</sys:String>
  <sys:String x:Key="app.startexperiences.desc">Windows 11 Başlat önerileri ve önerilen uygulama deneyimleri. Başlat çalışmaya devam eder; öneriler değişir.</sys:String>
