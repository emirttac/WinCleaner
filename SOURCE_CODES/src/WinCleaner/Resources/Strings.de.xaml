  <sys:String x:Key="app.bingsearch.name">Bing-Suche</sys:String>
  <sys:String x:Key="app.bingsearch.desc">Bing-/Such-Highlights-Paket, das Web-Ergebnisse in die Windows-Suche mischt. Lokale Suche bleibt; Bing-Extras fallen weg. Sicher entfernbar.</sys:String>
  <sys:String x:Key="app.outlook.name">Outlook (neu)</sys:String>
  <sys:String x:Key="app.outlook.desc">Die neue Outlook-for-Windows-App, die auf vielen PCs Mail / Kalender ersetzt. Wenn Sie klassisches Outlook oder einen anderen Client nutzen: Sicher entfernbar. Nicht entfernen, wenn dies Ihre tägliche Mail-App ist.</sys:String>
  <sys:String x:Key="app.stickynotes.name">Notizzettel</sys:String>
