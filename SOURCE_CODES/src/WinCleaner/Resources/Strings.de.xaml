  <sys:String x:Key="tweak.feathyperv.name">Enable Hyper-V</sys:String>
  <sys:String x:Key="tweak.feathyperv.desc">Aktiviert den Hyper-V-Funktionssatz. Neustart nötig. Vorsicht: Konflikt mit anderen Hypervisoren möglich. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.featwsl.name">Enable WSL + Virtual Machine Platform</sys:String>
  <sys:String x:Key="tweak.featwsl.desc">Aktiviert das Windows-Subsystem für Linux und die VM-Plattform. Neustart nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.featsandbox.name">Enable Windows Sandbox</sys:String>
  <sys:String x:Key="tweak.featsandbox.desc">Aktiviert Windows-Sandbox (Pro/Enterprise). Neustart nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.featdotnet.name">Enable .NET Framework 2/3/4 Features</sys:String>
  <sys:String x:Key="tweak.featdotnet.desc">Aktiviert NetFx3/NetFx4 für ältere Apps. Kann von Windows Update laden. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.featmedia.name">Enable Legacy Media Components</sys:String>
  <sys:String x:Key="tweak.featmedia.desc">Aktiviert Windows Media Player, DirectPlay und ältere Komponenten. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.featnfs.name">Enable NFS Client</sys:String>
  <sys:String x:Key="tweak.featnfs.desc">Aktiviert optionale NFS-Clientfunktionen. Vorsicht: nur für NFS-Freigaben nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.featf8.name">Enable Legacy F8 Boot Menu</sys:String>
  <sys:String x:Key="tweak.featf8.desc">Setzt bootmenupolicy=legacy, damit F8 wieder funktioniert. Neustart nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.wurecommended.name">Recommended Windows Update Deferrals</sys:String>
  <sys:String x:Key="tweak.wurecommended.desc">Schiebt Funktionsupdates 365 Tage und Qualitätsupdates 4 Tage auf, schließt WU-Treiber aus und benachrichtigt vor der Installation. Vorsicht: Sicherheitsupdates bleiben Ihre Aufgabe. Rückgängig: Ja.</sys:String>
