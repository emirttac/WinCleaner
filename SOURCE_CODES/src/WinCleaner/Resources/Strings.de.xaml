  <sys:String x:Key="tweak.hibernation.name">Disable Hibernation</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">Schaltet den Ruhezustand und die große hiberfil.sys per powercfg ab. Vorteil: Speicherplatz. Nachteil: kein Ruhezustand. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.wpbt.name">Disable WPBT Execution</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">Blockiert die OEM-WPBT-Nutzlast beim Start. Vorteil: weniger Hersteller-Software, die sich neu installiert. Vorsicht: seltene OEM-Tools brauchen WPBT. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.endtask.name">End Task From Taskbar</sys:String>
  <sys:String x:Key="tweak.endtask.desc">Fügt Task beenden zum Rechtsklick der Win11-Taskleiste hinzu. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Block Device Metadata From Network</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">Stoppt das Laden von Geräte-Begleitdaten aus dem Internet. Vorteil: weniger Hintergrundverkehr. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Disable Store Search Suggestions</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">Verweigert Jedem den Zugriff auf die lokale Store-Suchdatenbank. Vorsicht: Updates können die Rechte zurücksetzen. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Disable Explorer Folder Type Discovery</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">Löscht Explorer Bags/BagMRU und erzwingt FolderType=NotSpecified. Abmelden oder neu starten. Rückgängig nur teilweise.</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Unpin Explorer Home and Gallery</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">Löst Start und Galerie aus dem Navigationsbereich (Win11). LaunchTo bleibt. Explorer startet neu. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Disable Reserved Storage</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">Deaktiviert reservierten Speicher per DISM. Vorteil: mehrere GB. Vorsicht: Updates brauchen danach mehr freien Platz. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Disable Storage Sense</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">Schaltet die automatische Speicheroptimierung ab. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">Prefer IPv4 Over IPv6</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">Setzt DisabledComponents=32, damit IPv4 bevorzugt wird, ohne IPv6 ganz abzuschalten. Nicht mit 255 kombinieren. Neustart empfohlen. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.teredo.name">Disable Teredo</sys:String>
  <sys:String x:Key="tweak.teredo.desc">Deaktiviert die Teredo-IPv6-Tunnelschnittstelle per netsh. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.utctime.name">Hardware Clock Uses UTC</sys:String>
  <sys:String x:Key="tweak.utctime.desc">Behandelt die CMOS-Uhr per RealTimeIsUniversal als UTC. Hilft beim Dual-Boot mit Linux. Vorsicht: nur-Windows-PCs können die Uhr verstellen. Neustart nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">Disable svchost Service Splitting</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">Hebt SvcHostSplitThresholdInKB über den RAM, damit Dienste in weniger svchost-Prozessen laufen. Gefährlich für die Stabilität. Neustart nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Disable Notification Center and Toasts</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">Schaltet Info-Center und Toastbenachrichtigungen ab. Vorsicht: System- und App-Hinweise fehlen. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Enable Win32 Long Paths</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">Erlaubt Pfade länger als 260 Zeichen für geeignete Apps. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Verbose Logon Messages</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">Zeigt beim An- und Abmelden ausführlichen Statustext. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Verbose Blue Screen Details</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">Zeigt technische Bluescreen-Parameter und blendet das Trauergesicht aus. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.numlock.name">Num Lock On at Startup</sys:String>
  <sys:String x:Key="tweak.numlock.desc">Schaltet die Num-Taste für den Anmeldebildschirm und den aktuellen Benutzer ein. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Always Show Scrollbars</sys:String>
  <sys:String x:Key="tweak.scrollbars.desc">Schaltet automatisch ausgeblendete Bildlaufleisten ab. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.stickykeys.name">Disable Sticky Keys Shortcut</sys:String>
  <sys:String x:Key="tweak.stickykeys.desc">Schaltet die Einrastfunktion ab, damit die Umschalt-Meldung Spiele nicht unterbricht. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.settingshome.name">Hide Settings Home Page</sys:String>
  <sys:String x:Key="tweak.settingshome.desc">Blendet die Start- und Empfehlungsseite der Win11-Einstellungen aus. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.lockscreen.name">Disable Lock Screen</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">Überspringt den Sperrbildschirm und geht direkt zur Anmeldung. Vorsicht: etwas schwächerer Schutz vor Ort. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Keep Network On in Connected Standby</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">Erlaubt Netzwerk während Modern Standby (S0) am Netzteil. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Prefer Classic S3 Sleep</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">Setzt PlatformAoAcOverride=0 für klassischen S3-Schlaf. Vorsicht: nicht jedes Notebook kann das. Neustart nötig. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Show Battery Percentage</sys:String>
  <sys:String x:Key="tweak.batterypercent.desc">Zeigt den Akkustand als Zahl in der Taskleiste. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.loginblur.name">Disable Logon Acrylic Blur</sys:String>
  <sys:String x:Key="tweak.loginblur.desc">Schaltet die Acryl-Unschärfe hinter dem Anmeldebildschirm ab. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.windowsnap.name">Disable Window Snapping</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">Schaltet Aero Snap und die Fensteranordnung ab. Nützlich, wenn Andocken Spiele oder mehrere Monitore stört. Rückgängig: Ja.</sys:String>
  <sys:String x:Key="tweak.mpo.name">Disable Multiplane Overlay (MPO)</sys:String>
  <sys:String x:Key="tweak.mpo.desc">Schaltet DWM-Multiplane-Overlays ab (OverlayTestMode=5). Bei schwarzem Bild oder Rucklern. Neustart nötig. Rückgängig: Ja.</sys:String>
