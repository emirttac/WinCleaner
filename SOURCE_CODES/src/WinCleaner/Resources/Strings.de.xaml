  <sys:String x:Key="set.restore">Beim App-Start einen Wiederherstellungspunkt erstellen (empfohlen). Änderungen während der Sitzung erzeugen keine weiteren Punkte.</sys:String>
  <sys:String x:Key="restore.cardTitle">Systemwiederherstellungspunkt</sys:String>
