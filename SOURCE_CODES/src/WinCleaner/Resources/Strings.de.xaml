  <sys:String x:Key="svc.title">Dienste</sys:String>
  <sys:String x:Key="svc.subtitle">Kleine Programme, die Windows dauerhaft im Hintergrund ausführt. Unnötige Dienste zu deaktivieren entlastet den PC. Schalter = Deaktiviert.</sys:String>
