  <sys:String x:Key="app.copilot.name">Copilot</sys:String>
  <sys:String x:Key="app.copilot.desc">La app de chat Copilot de Windows en la barra de tareas / Inicio. Desaparecen los accesos de Copilot; se puede reinstalar desde la Store. Quítala con cuidado si realmente usas Copilot.</sys:String>
  <sys:String x:Key="app.bingsearch.name">Búsqueda Bing</sys:String>
  <sys:String x:Key="app.bingsearch.desc">El paquete Bing / destacados de búsqueda que mete resultados web en la Búsqueda de Windows. La búsqueda local sigue; desaparecen los extras de Bing. Seguro de quitar.</sys:String>
  <sys:String x:Key="app.outlook.name">Outlook (nuevo)</sys:String>
  <sys:String x:Key="app.outlook.desc">La nueva app Outlook para Windows que en muchos PCs sustituye Correo / Calendario. Segura de quitar. No la quites si es tu correo diario.</sys:String>
  <sys:String x:Key="app.stickynotes.name">Notas adhesivas</sys:String>
  <sys:String x:Key="app.stickynotes.desc">Microsoft Sticky Notes. Solo ocupan segundo plano. Seguras de quitar. Se pueden restaurar desde la Store / tu cuenta Microsoft.</sys:String>
  <sys:String x:Key="app.powerautomate.name">Power Automate</sys:String>
  <sys:String x:Key="app.powerautomate.desc">Automatización de escritorio / flujos incluidos con Windows. No lo necesitas. Seguro de quitar.</sys:String>
  <sys:String x:Key="app.devhome.name">Dev Home</sys:String>
  <sys:String x:Key="app.devhome.desc">El panel para desarrolladores de Microsoft (widgets, preparación del PC). Seguro de quitar. Solo Windows 11.</sys:String>
  <sys:String x:Key="app.xboxtcui.name">Xbox TCUI</sys:String>
  <sys:String x:Key="app.xboxtcui.desc">Interfaz Xbox usada por Game Bar / ventanas de Game Pass. Algunos avisos de Xbox en el juego pueden fallar. Déjala si conservas Game Bar o Game Pass.</sys:String>
  <sys:String x:Key="app.xboxspeech.name">Superposición de voz Xbox</sys:String>
  <sys:String x:Key="app.xboxspeech.desc">Superposición de voz a texto de Xbox Game Bar. Segura de quitar. Déjala si usas accesibilidad de Xbox.</sys:String>
  <sys:String x:Key="app.family.name">Microsoft Family</sys:String>
  <sys:String x:Key="app.family.desc">Family Safety / controles parentales. Segura de quitar. Microsoft Store.</sys:String>
  <sys:String x:Key="app.startexperiences.name">Experiencias de Inicio</sys:String>
  <sys:String x:Key="app.startexperiences.desc">Recomendaciones del menú Inicio / apps sugeridas en Windows 11. Algunas sugerencias de Inicio desaparecen. Inicio sigue funcionando, cambian las recomendaciones.</sys:String>
