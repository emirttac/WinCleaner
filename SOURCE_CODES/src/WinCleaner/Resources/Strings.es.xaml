  <sys:String x:Key="set.subtitle">Idioma, seguridad y registros: gestiona aquí el comportamiento de WinCleaner</sys:String>
  <sys:String x:Key="set.language">Idioma</sys:String>
  <sys:String x:Key="set.restore">Crear un punto de restauración al iniciar la aplicación (recomendado). Los cambios durante la sesión no crean puntos adicionales.</sys:String>
  <sys:String x:Key="restore.cardTitle">Punto de restauración del sistema</sys:String>
  <sys:String x:Key="restore.statusNone">Aún no se ha creado un punto de restauración para esta sesión.</sys:String>
