  <sys:String x:Key="tweak.featdotnet.name">Enable .NET Framework 2/3/4 Features</sys:String>
  <sys:String x:Key="tweak.featdotnet.desc">Activa servicios avanzados NetFx3 / NetFx4. Puede descargar desde Windows Update.</sys:String>
  <sys:String x:Key="tweak.featmedia.name">Enable Legacy Media Components</sys:String>
  <sys:String x:Key="tweak.featmedia.desc">Activa Windows Media Player, DirectPlay y componentes heredados.</sys:String>
  <sys:String x:Key="tweak.featnfs.name">Enable NFS Client</sys:String>
  <sys:String x:Key="tweak.featnfs.desc">Activa las funciones opcionales de cliente NFS. Precaución: solo hace falta para recursos NFS.</sys:String>
  <sys:String x:Key="tweak.featf8.name">Enable Legacy F8 Boot Menu</sys:String>
  <sys:String x:Key="tweak.featf8.desc">Pone bootmenupolicy=legacy para que F8 funcione. Requiere reinicio.</sys:String>
  <sys:String x:Key="tweak.wurecommended.name">Recommended Windows Update Deferrals</sys:String>
  <sys:String x:Key="tweak.wurecommended.desc">Aplaza actualizaciones de características 365 días y de calidad 4 días, excluye controladores de WU y avisa antes de instalar. Precaución: las actualizaciones de seguridad siguen siendo su responsabilidad.</sys:String>
