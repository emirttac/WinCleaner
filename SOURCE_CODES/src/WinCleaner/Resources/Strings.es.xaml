  <sys:String x:Key="tweak.hibernation.name">Disable Hibernation</sys:String>
  <sys:String x:Key="tweak.hibernation.desc">Apaga la hibernación y el archivo hiberfil.sys con powercfg. Beneficio: espacio en disco. Inconveniente: se pierde hibernar.</sys:String>
  <sys:String x:Key="tweak.wpbt.name">Disable WPBT Execution</sys:String>
  <sys:String x:Key="tweak.wpbt.desc">Bloquea la carga WPBT del fabricante al arrancar. Beneficio: menos programas del fabricante que se reinstalan. Precaución: alguna herramienta OEM rara puede depender de WPBT.</sys:String>
  <sys:String x:Key="tweak.endtask.name">End Task From Taskbar</sys:String>
  <sys:String x:Key="tweak.endtask.desc">Añade Finalizar tarea al menú contextual de la barra de Win11.</sys:String>
  <sys:String x:Key="tweak.devmeta.name">Block Device Metadata From Network</sys:String>
  <sys:String x:Key="tweak.devmeta.desc">Impide que Windows descargue metadatos de dispositivos. Beneficio: menos tráfico en segundo plano.</sys:String>
  <sys:String x:Key="tweak.storesearch.name">Disable Store Search Suggestions</sys:String>
  <sys:String x:Key="tweak.storesearch.desc">Niega a Todos el acceso a la base local de búsqueda de Store. Precaución: las actualizaciones pueden restablecer los permisos.</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.name">Disable Explorer Folder Type Discovery</sys:String>
  <sys:String x:Key="tweak.folderdiscovery.desc">Borra Bags/BagMRU y fuerza FolderType=NotSpecified. Hace falta cerrar sesión o reiniciar. Deshacer es parcial.</sys:String>
  <sys:String x:Key="tweak.homegallery.name">Unpin Explorer Home and Gallery</sys:String>
  <sys:String x:Key="tweak.homegallery.desc">Desancla Inicio y Galería del panel de navegación (Win11). No cambia LaunchTo. El Explorador se reinicia.</sys:String>
  <sys:String x:Key="tweak.reservedstorage.name">Disable Reserved Storage</sys:String>
  <sys:String x:Key="tweak.reservedstorage.desc">Desactiva el almacenamiento reservado con DISM. Beneficio: varios GB. Precaución: las actualizaciones pueden pedir más espacio.</sys:String>
  <sys:String x:Key="tweak.storagesense.name">Disable Storage Sense</sys:String>
  <sys:String x:Key="tweak.storagesense.desc">Apaga la limpieza automática del Sensor de almacenamiento.</sys:String>
  <sys:String x:Key="tweak.ipv4pref.name">Prefer IPv4 Over IPv6</sys:String>
  <sys:String x:Key="tweak.ipv4pref.desc">Pone DisabledComponents=32 para preferir IPv4 sin apagar IPv6 del todo. No lo combine con 255. Se recomienda reiniciar.</sys:String>
  <sys:String x:Key="tweak.teredo.name">Disable Teredo</sys:String>
  <sys:String x:Key="tweak.teredo.desc">Desactiva la interfaz de túnel Teredo IPv6 con netsh.</sys:String>
  <sys:String x:Key="tweak.utctime.name">Hardware Clock Uses UTC</sys:String>
  <sys:String x:Key="tweak.utctime.desc">Trata el reloj CMOS como UTC con RealTimeIsUniversal. Útil en arranque dual con Linux. Precaución: en un PC solo con Windows la hora puede desviarse. Requiere reinicio.</sys:String>
  <sys:String x:Key="tweak.svchostsplit.name">Disable svchost Service Splitting</sys:String>
  <sys:String x:Key="tweak.svchostsplit.desc">Sube SvcHostSplitThresholdInKB por encima de la RAM para agrupar servicios. Peligroso para la estabilidad. Requiere reinicio.</sys:String>
  <sys:String x:Key="tweak.traynotif.name">Disable Notification Center and Toasts</sys:String>
  <sys:String x:Key="tweak.traynotif.desc">Desactiva el centro de notificaciones y los avisos. Precaución: se pierden alertas del sistema y de las aplicaciones.</sys:String>
  <sys:String x:Key="tweak.longpaths.name">Enable Win32 Long Paths</sys:String>
  <sys:String x:Key="tweak.longpaths.desc">Permite rutas de más de 260 caracteres en aplicaciones compatibles.</sys:String>
  <sys:String x:Key="tweak.verboselogon.name">Verbose Logon Messages</sys:String>
  <sys:String x:Key="tweak.verboselogon.desc">Muestra texto de estado detallado al iniciar y cerrar sesión.</sys:String>
  <sys:String x:Key="tweak.bsodverbose.name">Verbose Blue Screen Details</sys:String>
  <sys:String x:Key="tweak.bsodverbose.desc">Muestra parámetros técnicos de la pantalla azul y quita la cara triste.</sys:String>
  <sys:String x:Key="tweak.numlock.name">Num Lock On at Startup</sys:String>
  <sys:String x:Key="tweak.numlock.desc">Activa Bloq Num en la pantalla de inicio y para el usuario actual.</sys:String>
  <sys:String x:Key="tweak.scrollbars.name">Always Show Scrollbars</sys:String>
  <sys:String x:Key="tweak.scrollbars.desc">Desactiva las barras de desplazamiento que se ocultan solas.</sys:String>
  <sys:String x:Key="tweak.stickykeys.name">Disable Sticky Keys Shortcut</sys:String>
  <sys:String x:Key="tweak.stickykeys.desc">Apaga las teclas especiales para que la ventana de Mayús no interrumpa los juegos.</sys:String>
  <sys:String x:Key="tweak.settingshome.name">Hide Settings Home Page</sys:String>
  <sys:String x:Key="tweak.settingshome.desc">Oculta la página de inicio y recomendaciones de Configuración en Win11.</sys:String>
  <sys:String x:Key="tweak.lockscreen.name">Disable Lock Screen</sys:String>
  <sys:String x:Key="tweak.lockscreen.desc">Omite la pantalla de bloqueo y pide la contraseña o el PIN. Precaución: algo menos de protección física.</sys:String>
  <sys:String x:Key="tweak.s0standby.name">Keep Network On in Connected Standby</sys:String>
  <sys:String x:Key="tweak.s0standby.desc">Permite la red durante la espera moderna (S0) con corriente.</sys:String>
  <sys:String x:Key="tweak.s3sleep.name">Prefer Classic S3 Sleep</sys:String>
  <sys:String x:Key="tweak.s3sleep.desc">Pone PlatformAoAcOverride=0 para preferir el sueño S3. Precaución: no todos los portátiles lo admiten. Requiere reinicio.</sys:String>
  <sys:String x:Key="tweak.batterypercent.name">Show Battery Percentage</sys:String>
  <sys:String x:Key="tweak.batterypercent.desc">Muestra el porcentaje numérico de batería en la bandeja.</sys:String>
  <sys:String x:Key="tweak.loginblur.name">Disable Logon Acrylic Blur</sys:String>
  <sys:String x:Key="tweak.loginblur.desc">Quita el desenfoque acrílico detrás de la pantalla de inicio de sesión.</sys:String>
  <sys:String x:Key="tweak.windowsnap.name">Disable Window Snapping</sys:String>
  <sys:String x:Key="tweak.windowsnap.desc">Apaga Aero Snap y la organización de ventanas. Útil si el ajuste estorba en juegos o con varios monitores.</sys:String>
  <sys:String x:Key="tweak.mpo.name">Disable Multiplane Overlay (MPO)</sys:String>
  <sys:String x:Key="tweak.mpo.desc">Desactiva las superposiciones multiplano de DWM (OverlayTestMode=5). Útil con pantalla negra o tirones. Requiere reinicio.</sys:String>
