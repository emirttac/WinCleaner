  <sys:String x:Key="restore.warnTitle">Creando punto de restauración</sys:String>
  <sys:String x:Key="restore.warnBody">Puede tardar alrededor de un minuto. Espera: WinCleaner se desbloqueará al terminar.</sys:String>
