<UserControl x:Class="WinCleaner.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ui:DynamicScrollViewer>
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>

    <TextBlock Text="{Binding SafetyTitle}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
    <ui:Card Margin="0,0,0,10" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            <TextBlock Text="{Binding RestoreCardTitle}" Style="{StaticResource CardTitleStyle}"/>
          </StackPanel>
          <TextBlock Text="{Binding RestoreStatusText}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="12"/>
        </StackPanel>
        <ui:Button Grid.Column="1"
                   Content="{Binding CreateRestoreLabel}"
                   Command="{Binding CreateRestoreCommand}"
                   Appearance="Primary"
                   Icon="{ui:SymbolIcon Save24}"
                   VerticalAlignment="Center"
                   IsEnabled="{Binding CanRunQuickActions}"/>
      </Grid>
    </ui:Card>

    <ui:Card Margin="0,0,0,10" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,8,0"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TimeMachineTitle}" Style="{StaticResource CardTitleStyle}"/>
          </StackPanel>
          <TextBlock Text="{Binding TimeMachineStatus}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="{Binding TimeMachineRevertLabel}"
                     Command="{Binding RevertLatestSnapshotCommand}"
                     Appearance="Primary"
                     Icon="{ui:SymbolIcon ArrowUndo24}"
                     Margin="0,0,8,0"
                     IsEnabled="{Binding HasSnapshot}"/>
          <ui:Button Content="{Binding TimeMachineHistoryLabel}"
                     Command="{Binding OpenTimeMachineCommand}"
                     Appearance="Secondary"
                     Icon="{ui:SymbolIcon Timeline24}"/>
        </StackPanel>
      </Grid>
    </ui:Card>

    <TextBlock Text="{Binding SystemTitle}" Style="{StaticResource SectionHeaderStyle}"/>
    <UniformGrid Columns="2">
      <ui:Card Margin="0,0,10,10" Padding="14">
        <StackPanel>
          <TextBlock Text="{Binding CpuLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
          <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,0,10" Padding="14">
        <StackPanel>
          <TextBlock Text="{Binding GpuLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
          <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,10,10" Padding="14">
        <StackPanel>
          <TextBlock Text="{Binding RamLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
          <TextBlock Text="{Binding RamText}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,0,10" Padding="14">
        <StackPanel>
          <TextBlock Text="{Binding OsLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
          <TextBlock Text="{Binding OsText}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </ui:Card>
    </UniformGrid>

    <ui:Card Margin="0,0,0,10" Padding="16">
      <StackPanel>
        <TextBlock Text="{Binding DisksLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
        <TextBlock Text="{Binding DiskText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
      </StackPanel>
    </ui:Card>

    <TextBlock Text="{Binding QuickTitle}" Style="{StaticResource SectionHeaderStyle}"/>
    <UniformGrid Columns="3">
      <ui:CardAction Margin="0,0,10,10" Padding="14" MinHeight="96"
                     Command="{Binding ApplyGamerCommand}"
                     IsEnabled="{Binding CanRunQuickActions}">
        <StackPanel>
          <ui:SymbolIcon Symbol="XboxController24" FontSize="20" Margin="0,0,0,8"
                         Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
          <TextBlock Text="{Binding ApplyGamerLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ApplyGamerDesc}" Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </ui:CardAction>
      <ui:CardAction Margin="0,0,10,10" Padding="14" MinHeight="96"
                     Command="{Binding FlushDnsCommand}"
                     IsEnabled="{Binding CanRunQuickActions}">
        <StackPanel>
          <ui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,0,8"
                         Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
          <TextBlock Text="{Binding FlushDnsLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FlushDnsDesc}" Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </ui:CardAction>
      <ui:CardAction Margin="0,0,0,10" Padding="14" MinHeight="96"
                     Command="{Binding CleanTempCommand}"
                     IsEnabled="{Binding CanRunQuickActions}">
        <StackPanel>
          <ui:SymbolIcon Symbol="Broom24" FontSize="20" Margin="0,0,0,8"
                         Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
          <TextBlock Text="{Binding CleanTempLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CleanTempDesc}" Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </ui:CardAction>
    </UniformGrid>

    <TextBlock Text="{Binding RecentTitle}" Style="{StaticResource SectionHeaderStyle}"/>
    <ui:Card Padding="14" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="{Binding RecentEmpty}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Visibility="{Binding HasRecentChanges, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
        <ItemsControl ItemsSource="{Binding RecentChanges}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <ui:Button DockPanel.Dock="Right"
                           Content="{Binding RevertLabel}"
                           Command="{Binding RevertCommand}"
                           Appearance="Secondary"
                           Padding="10,4" FontSize="11"
                           Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12"/>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ui:Card>
  </StackPanel>
  </ui:DynamicScrollViewer>
</UserControl>
