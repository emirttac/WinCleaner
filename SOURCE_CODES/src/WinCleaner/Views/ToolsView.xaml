<UserControl x:Class="WinCleaner.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="False"
                Padding="0,0,4,0">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"/>

      <TextBlock Text="{Binding MaintenanceTitle}" Style="{StaticResource SectionHeaderStyle}"/>
      <UniformGrid Columns="3">
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding CreateRestoreCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
            <TextBlock Text="{Binding CreateRestoreLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.restore}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding CleanTempCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="Broom24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
            <TextBlock Text="{Binding CleanTempLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.cleanTemp}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,10" Padding="12" MinHeight="84"
                       Command="{Binding OpenDiskCleanupCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
            <TextBlock Text="{Binding DiskCleanupLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.diskCleanup}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding RunSfcDismRepairCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="WrenchScrewdriver24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource WarningBrush}"/>
            <TextBlock Text="{Binding SfcDismLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.sfcDism}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding RunWinsxsCleanupCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="Delete24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource WarningBrush}"/>
            <TextBlock Text="{Binding WinsxsLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.winsxs}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,10" Padding="12" MinHeight="84"
                       Command="{Binding CreateGodModeCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="PanelLeftExpand24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
            <TextBlock Text="{Binding GodModeLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.godMode}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding ResetWindowsUpdateCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource WarningBrush}"/>
            <TextBlock Text="{Binding WuResetLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.wuReset}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding ResetNetworkStackCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="WifiWarning24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource WarningBrush}"/>
            <TextBlock Text="{Binding NetworkResetLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.networkReset}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,10" Padding="12" MinHeight="84"
                       Command="{Binding OpenMemoryDiagnosticCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="Memory16" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
            <TextBlock Text="{Binding MemoryDiagLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.memoryDiag}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="84"
                       Command="{Binding AnalyzeDiskSpaceCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <ui:SymbolIcon Symbol="DataPie24" FontSize="18" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
            <TextBlock Text="{Binding DiskAnalyzeLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.desc.diskAnalyze}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>

      <ui:Card Margin="0,4,0,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding TakeOwnTitle}" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="{Binding TakeOwnDescription}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="12"/>
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1"
                           IsChecked="{Binding TakeOwnershipEnabled, Mode=OneWay}"
                           IsEnabled="{Binding CanRunTools}"
                           Command="{Binding ToggleTakeOwnershipCommand}"
                           VerticalAlignment="Center"/>
        </Grid>
      </ui:Card>

      <TextBlock Text="{Binding FixesTitle}" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0"/>
      <UniformGrid Columns="3">
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="72"
                       Command="{Binding ConfigureNtpPoolCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <TextBlock Text="{Binding NtpLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.ntp.desc}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="72"
                       Command="{Binding OpenAutologonCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <TextBlock Text="{Binding AutologonLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.autologon.desc}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,10" Padding="12" MinHeight="72"
                       Command="{Binding RepairWingetCommand}" IsEnabled="{Binding CanRunTools}">
          <StackPanel>
            <TextBlock Text="{Binding WingetRepairLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.wingetRepair.desc}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="72"
                       Command="{Binding ExportRegistryCommand}" IsEnabled="{Binding CanRunTools}"
                       AutomationProperties.Name="{Binding RegExportLabel}"
                       AutomationProperties.HelpText="{DynamicResource tools.regExport.desc}">
          <StackPanel>
            <TextBlock Text="{Binding RegExportLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.regExport.desc}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,10,10" Padding="12" MinHeight="72"
                       Command="{Binding ImportRegistryCommand}" IsEnabled="{Binding CanRunTools}"
                       AutomationProperties.Name="{Binding RegImportLabel}"
                       AutomationProperties.HelpText="{DynamicResource tools.regImport.desc}">
          <StackPanel>
            <TextBlock Text="{Binding RegImportLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource tools.regImport.desc}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>

      <TextBlock Text="{Binding LegacyTitle}" Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,0"/>
      <ItemsControl ItemsSource="{Binding LegacyPanels}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Button Content="{Binding Title}" Margin="0,0,10,10"
                       Appearance="Secondary" HorizontalAlignment="Stretch"
                       AutomationProperties.Name="{Binding Title}"
                       FocusVisualStyle="{StaticResource AppFocusVisual}"
                       Command="{Binding DataContext.OpenLegacyPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       CommandParameter="{Binding Target}"
                       IsEnabled="{Binding DataContext.CanRunTools, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding TweaksSectionTitle}" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0"/>
      <ui:InfoBar Title="{DynamicResource common.loading}"
                  IsOpen="True"
                  IsClosable="False"
                  Severity="Informational"
                  Margin="0,0,0,10"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="0,0,0,10" Padding="16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}"/>
                    <Border Style="{StaticResource RiskBadgeStyle}"
                            Background="{Binding Risk, Converter={StaticResource RiskToBrush}}">
                      <TextBlock Text="{Binding RiskLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Risk, Converter={StaticResource RiskToBadgeText}}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                             FontSize="12" LineHeight="18"
                             ToolTip="{Binding Description}"/>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding IsApplied, Mode=OneWay}"
                                 IsEnabled="{Binding CanToggle}"
                                 Command="{Binding ToggleCommand}"
                                 AutomationProperties.Name="{Binding Title}"
                                 AutomationProperties.HelpText="{Binding Description}"
                                 FocusVisualStyle="{StaticResource AppFocusVisual}"
                                 VerticalAlignment="Center"/>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
