<ui:FluentWindow x:Class="WinCleaner.Views.ConfirmDangerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dangerous Action" Height="300" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource BgPanelBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{Binding ElementName=TitleText, Path=Text}" ShowMaximize="False" ShowMinimize="False"/>
    <Grid Grid.Row="1" Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"/>
        <TextBlock x:Name="TitleText" Text="Dangerous Action" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="This change can affect system stability or security. Check the box and confirm to continue."
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <CheckBox x:Name="AckCheck" Grid.Row="2" Content="I understand the risks" Margin="0,12,0,16"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button x:Name="CancelButton" Content="{DynamicResource common.cancel}"
                   Appearance="Secondary" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
        <ui:Button x:Name="OkButton" Content="{DynamicResource common.confirm}"
                   Appearance="Danger" IsEnabled="False" Click="Ok_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
