<ui:FluentWindow x:Class="WinCleaner.Views.BusyProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource busy.title}"
        Height="240" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ExtendsContentIntoTitleBar="False"
        WindowBackdropType="None"
        Background="{DynamicResource BgPanelBrush}">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgPanelBrush}">
    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="TitleText"
                 Text="{DynamicResource busy.title}"
                 FontSize="14" FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="0,0,0,16"
                 IsHitTestVisible="False"/>

      <StackPanel Grid.Row="1" VerticalAlignment="Center">
        <TextBlock x:Name="MessageText"
                   Text="{DynamicResource busy.working}"
                   FontSize="16" FontWeight="SemiBold"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   IsHitTestVisible="False"/>

        <ProgressBar x:Name="ProgressBar"
                     Height="10"
                     Margin="0,18,0,8"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"/>

        <TextBlock x:Name="DetailText"
                   Text=""
                   FontSize="12"
                   TextAlignment="Center" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   MaxHeight="40"
                   Foreground="{DynamicResource TextMutedBrush}"
                   IsHitTestVisible="False"/>

        <TextBlock x:Name="HintText"
                   Text="{DynamicResource busy.pleaseWait}"
                   Margin="0,12,0,0"
                   FontSize="12"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsHitTestVisible="False"/>
      </StackPanel>
    </Grid>
  </Border>
</ui:FluentWindow>
