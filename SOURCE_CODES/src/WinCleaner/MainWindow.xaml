<ui:FluentWindow x:Class="WinCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:WinCleaner.ViewModels"
        Title="{Binding AppTitle}"
        Height="740" Width="1200"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        KeyboardNavigation.TabNavigation="Continue"
        Background="{DynamicResource BgDeepBrush}">
  <ui:FluentWindow.DataContext>
    <vm:MainViewModel/>
  </ui:FluentWindow.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Full-window dimmer while modal work (e.g. restore point) runs -->
    <Border x:Name="BusyOverlay"
            Grid.RowSpan="2"
            Panel.ZIndex="1000"
            Background="#B3000000"
            Visibility="Collapsed"
            IsHitTestVisible="True"
            Focusable="True"/>

    <ui:TitleBar Grid.Row="0"
                 Title="{Binding AppTitle}"
                 ShowMaximize="True"
                 ShowMinimize="True"
                 ForceShutdown="False">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="Broom24" FontSize="16"
                       Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,8,16,6">
            <TextBlock Text="WinCleaner" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding OsBanner}" FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,2,0,0" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Margin="10,4,10,10" Padding="0,8,0,0"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
              <ui:Button Command="{Binding UndoAllCommand}"
                         Appearance="Secondary"
                         Icon="{ui:SymbolIcon ArrowUndo24}"
                         Content="{Binding UndoLabel}"
                         AutomationProperties.Name="{Binding UndoLabel}"
                         AutomationProperties.HelpText="{Binding UndoLabel}"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,0,6"
                         Padding="8,6"
                         FontSize="12"/>
              <TextBlock Text="{Binding StatusText}" FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Opacity="0.75"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        Padding="0,0,2,4">
            <StackPanel>
              <TextBlock Text="{DynamicResource nav.group.start}" Style="{StaticResource NavSectionHeaderStyle}" Margin="14,2,10,2"/>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavDashboard}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.start}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=dashboard, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Home24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavDashboard}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavPresets}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.start}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=presets, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Rocket24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavPresets}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>

              <TextBlock Text="{DynamicResource nav.group.optimize}" Style="{StaticResource NavSectionHeaderStyle}"/>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavGaming}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.optimize}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=gaming, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="XboxController24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavGaming}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavTelemetry}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.optimize}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=telemetry, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="ShieldLock24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavTelemetry}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavBloatware}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.optimize}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=bloatware, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavBloatware}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavVisual}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.optimize}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=visual, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Color24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavVisual}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavWin11}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.optimize}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=win11, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Window24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavWin11}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>

              <TextBlock Text="{DynamicResource nav.group.system}" Style="{StaticResource NavSectionHeaderStyle}"/>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavServices}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.system}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=services, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Server24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavServices}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavNetwork}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.system}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=network, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavNetwork}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavTools}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.system}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=tools, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="WrenchScrewdriver24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavTools}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>

              <TextBlock Text="{DynamicResource nav.group.more}" Style="{StaticResource NavSectionHeaderStyle}"/>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavInstaller}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.more}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=installer, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Box24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavInstaller}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource SidebarButtonStyle}" GroupName="nav"
                           AutomationProperties.Name="{Binding NavSettings}"
                           AutomationProperties.HelpText="{DynamicResource nav.group.more}"
                           IsChecked="{Binding SelectedNav, Converter={StaticResource NavEq}, ConverterParameter=settings, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock Text="{Binding NavSettings}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" Padding="20,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <ui:TextBox PlaceholderText="{Binding SearchPlaceholder}"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Icon="{ui:SymbolIcon Search24}"
                      ClearButtonEnabled="True"
                      MinHeight="32"
                      AutomationProperties.Name="{Binding SearchPlaceholder}"
                      AutomationProperties.HelpText="{Binding SearchPlaceholder}"/>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24"/>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
